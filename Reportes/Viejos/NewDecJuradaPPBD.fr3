    <TfrxFooter Name="Footer2" Height="467.06322646" Left="0" Top="438.42548" Width="718.1107">
      <TfrxMemoView Name="Memo37" Left="2.77953" Top="35.23624" Width="712.44135984" Height="43.46458646" ShowHint="False" Font.Charset="1" Font.Color="0" Font.Height="-12" Font.Name="Arial" Font.Style="0" HAlign="haBlock" ParentFont="False" Text="Entre la MUNICIPALIDAD DE LA CIUDAD DE FORMOSA, representado por el Dr. Fernando Martin Rigotti (Apoderado) con el patrocinio letrado                                                                                            , en adelante el ACREEDOR, con domicilio legal constituido en la calle San Martin Nº 750, por una parte y por la otra,"/>
