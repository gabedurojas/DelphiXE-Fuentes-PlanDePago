      <TfrxMemoView Name="Memo63" Left="396.85065" Top="392.80334" Width="37.7953" Height="13.22834646" ShowHint="False" Font.Charset="1" Font.Color="0" Font.Height="-9" Font.Name="Arial" Font.Style="1" HAlign="haRight" ParentFont="False" Text="Firma"/>
