        object Memo41: TfrxMemoView
          AllowVectorExport = True
          Left = 2.779530000000000000
          Top = 275.039580000000000000
          Width = 714.331170000000000000
          Height = 58.582706460000000000
          Font.Charset = DEFAULT_CHARSET
          Font.Color = clBlack
          Font.Height = -9
          Font.Name = 'Arial'
          Font.Style = [fsBold]
          Frame.Typ = []
          HAlign = haBlock
          Memo.UTF8W = (
            
              'En este acto me notifico que la caducidad del Plan de Facilidade' +
              's de Pagos opera de pleno derecho y sin necesidad de interpelaci' +
              #243'n alguna, y queda configurada en el caso de presentarse algunos' +
              ' de los supuestos estipulados en el Articulo N'#186' 20 de la Ordenan' +
              'za N'#186' 7740/22 y de que operada la caducidad, la Agencia de Recau' +
              'daci'#243'n queda habilitada para disponer el inicio o prosecuci'#243'n, s' +
              'eg'#250'n  corresponda, de las acciones judiciales tendientes a obten' +
              'er el cobro del toral adeudado. La caducidad mencionada en el p'#225 +
              'rrafo anterior causar'#225' la p'#233'rdida de los beneficios dispuestos e' +
              'n el art'#237'culo.7 de la Ordenanza N'#176' 7740/22, en proporci'#243'n a la d' +
              'euda pendiente al momento en que la caducidad opere sus efectos ')
          ParentFont = False
        end
        object Memo51: TfrxMemoView
          AllowVectorExport = True
          Left = 2.779530000000000000
          Top = 333.527830000000000000
          Width = 714.331170000000000000
          Height = 24.566936460000000000
          Font.Charset = DEFAULT_CHARSET
          Font.Color = clBlack
          Font.Height = -9
          Font.Name = 'Arial'
          Font.Style = []
          Frame.Typ = []
          HAlign = haBlock
          Memo.UTF8W = (
            
              'Por la presente reconozco de forma expresa la obligaci'#243'n tributa' +
              'ria, notific'#225'ndome y aceptando la interrupci'#243'n de la prescripci'#243 +
              'n, tal como la establece la Ordenanza N'#176' 7147/17, Art. 90 a 93.')
          ParentFont = False
        end
