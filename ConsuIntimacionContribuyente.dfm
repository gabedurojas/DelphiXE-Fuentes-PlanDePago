        object Memo40: TfrxMemoView
          AllowVectorExport = True
          Left = 2.779530000000000000
          Top = 101.267780000000000000
          Width = 714.331170000000000000
          Height = 24.566936460000000000
          Font.Charset = DEFAULT_CHARSET
          Font.Color = clBlack
          Font.Height = -9
          Font.Name = 'Arial'
          Font.Style = []
          Frame.Typ = []
          HAlign = haBlock
          Memo.UTF8W = (
            
              'afirma que los datos consignados en esta Declaraci'#243'n Jurada son ' +
              'correctos y completos y que se ha confeccionado la misma sin omi' +
              'tir ni falsear dato alguno que deba contener, siendo fiel expres' +
              'i'#243'n de la verdad. ')
          ParentFont = False
        end
        object Memo45: TfrxMemoView
          AllowVectorExport = True
          Left = 2.779530000000000000
          Top = 126.519790000000000000
          Width = 714.331170000000000000
          Height = 20.787406460000000000
          Font.Charset = DEFAULT_CHARSET
          Font.Color = clBlack
          Font.Height = -9
          Font.Name = 'Arial'
          Font.Style = []
          Frame.Typ = []
          HAlign = haBlock
          Memo.UTF8W = (
            
              'Asimismo, de acuerdo a lo establecido por los Art. 34 a 38 de la' +
              ' Ord. N'#186' 7147/17, Ordenanza N'#186' 7740/22 y la Disposici'#243'n N'#186' '#8230'./22' +
              ',, de la Agencia de Recaudaci'#243'n de la Municipalidad de Formosa; ' +
              'constituyo y/o actualizo mi domicilio fiscal en')
          ParentFont = False
        end
        object Memo49: TfrxMemoView
          AllowVectorExport = True
          Left = 2.779530000000000000
          Top = 169.330860000000000000
          Width = 714.331170000000000000
          Height = 35.905526460000000000
          Font.Charset = DEFAULT_CHARSET
          Font.Color = clBlack
          Font.Height = -9
          Font.Name = 'Arial'
          Font.Style = []
          Frame.Typ = []
          Memo.UTF8W = (
            'y domicilio fiscal electronico'
            
              'a todos los efectos del presente, declaro mi conformidad al mism' +
              'o, allan'#225'ndome incondicionalmente, desistiendo y renunciando a t' +
              'oda acci'#243'n y derecho referido a la determinaci'#243'n y/o liquidaci'#243'n' +
              ' por parte del Municipio de los Tributos y Derechos incluidos en' +
              ' el presente convenio de pagos.')
          ParentFont = False
        end
        object Memo50: TfrxMemoView
          AllowVectorExport = True
          Left = 2.779530000000000000
          Top = 205.567100000000000000
          Width = 714.331170000000000000
          Height = 69.921296460000000000
          Font.Charset = DEFAULT_CHARSET
          Font.Color = clBlack
          Font.Height = -9
          Font.Name = 'Arial'
          Font.Style = []
          Frame.Typ = []
          HAlign = haBlock
          Memo.UTF8W = (
            
              'Asimismo, acepto expresamente mi responsabilidad, consistiendo e' +
              'l pago de las Multas incluidas en el presente Plan de Pagos, con' +
              'forme surgen del/las Acta/s de Infracci'#243'n confeccionada/s por lo' +
              's inspectores de la Municipalidad de Formosa. Asimismo, declaro ' +
              'conocer que en caso de incluirse deuda por la Tasa de Registro e' +
              ' Inspecci'#243'n (Ord. 6253/12), y/o la Contribuci'#243'n por Servicios qu' +
              'e inciden sobre las actividades Comerciales, Industriales y de S' +
              'ervicios (Ord. 7147/17), mi adhesi'#243'n al presente R'#233'gimen de Regu' +
              'larizaci'#243'n de Deudas y Planes de Facilidades de Pago se efect'#250'a ' +
              'sobre la base de las declaraciones juradas y pagos efectuados po' +
              'r mi parte en car'#225'cter de contribuyente y/o responsable, sin per' +
              'juicio de que la Agencia de Recaudaci'#243'n pueda disponer acciones ' +
              'o requerir en el futuro la presentaci'#243'n de comprobantes respalda' +
              'torios a los efectos de su verificaci'#243'n.')
          ParentFont = False
        end
