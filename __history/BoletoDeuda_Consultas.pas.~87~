procedure TConsultas_BoletoDeuda.imprimeClick(Sender: TObject);
var t,y,a:integer;
   texto:string;
   ReporteRst: TfrxReport;
   frxDB1: TfrxDBDataset;
   DtsObjetos:TClientDataSet;
begin
 a:=messagedlg('Desea Imprimir las Boletas de Deuda de este Lote seleccionado?',mtWarning,[mbok,mbCancel],0);
 if a = 1 then begin
 try
  DtsObjetos:=TClientDataSet.Create(nil);
  DtsObjetos.FieldDefs.Clear;
  DtsObjetos.Active:=False;
  with DtsObjetos.FieldDefs.AddFieldDef do begin
   Name:='Orden';
   DataType:=ftInteger;
  end;
  with DtsObjetos.FieldDefs.AddFieldDef do begin
   Name:='Nrolote';
   DataType:=ftString;Size:=50;
  end;
  with DtsObjetos.FieldDefs.AddFieldDef do begin
   Name:='NroBoletoDeuda';
   DataType:=ftString;Size:=50;
  end;
  with DtsObjetos.FieldDefs.AddFieldDef do begin
   Name:='TotalDeuda';
   DataType:=ftString;Size:=50;
  end;
  with DtsObjetos.FieldDefs.AddFieldDef do begin
   Name:='Contribuyente';
   DataType:=ftString;Size:=250;
  end;
  with DtsObjetos.FieldDefs.AddFieldDef do begin
   Name:='EstadoIntimacion';
   DataType:=ftString;Size:=100;
  end;
  DtsObjetos.CreateDataSet;
  DtsObjetos.Active:=True;
  y:=1;
  for t:=1 to grilla1.RowCount-1 do begin
   DtsObjetos.Append;
   DtsObjetos.FieldValues['Orden']:=y;
   DtsObjetos.FieldValues['Nrolote']:=grilla1.Cells[1,t];
   DtsObjetos.FieldValues['NroBoletoDeuda']:=grilla1.Cells[2,t] + ger;
   DtsObjetos.FieldValues['TotalDeuda']:=grilla1.Cells[4,t];
   DtsObjetos.FieldValues['Contribuyente']:=grilla1.Cells[5,t];
   DtsObjetos.FieldValues['EstadoIntimacion']:=grilla1.Cells[3,t];
   DtsObjetos.Post;
   y:=y+1;
  end;
  except
    on E: Exception do EnviarLog(Self.Caption, E.Message);
  end;

  //Imprimiendo
  try
   ReporteRst:=TfrxReport.Create(nil);
   frxDB1:=TfrxDBDataset.Create(nil);
   frxDB1.DataSet:=DtsObjetos;
   frxDB1.UserName:='frxDBDataset1';
   ReporteRst.DataSets.Add(frxDB1);
   ReporteRst.LoadFromFile(Modulo2.Sistema.Path_todo + '\Reportes\Con_BoletaDeuda.fr3');
   TfrxPictureView(ReporteRst.FindObject('Logo1')).Picture.LoadFromFile(Modulo2.Sistema.Path_todo + '\Imagenes\LogoM2.jpg');
   TfrxPictureView(ReporteRst.FindObject('Logo2')).Picture.LoadFromFile(Modulo2.Sistema.Path_todo + '\Imagenes\logoformosa.jpg');
   ReporteRst.Variables['ElLote'] := QuotedStr(ellote);
   ReporteRst.Variables['LaDispo'] := QuotedStr(dispo);
   ReporteRst.Variables['LugarFecha'] := QuotedStr('FORMOSA, ' + FechaToStr(FechaAct,'DDMMAAAA'));
   ReporteRst.Variables['NroUsuario'] := QuotedStr(Modulo2.Usuario.UsuNro + ' /Reg.Imp ' + AuditaImpresos('Imp Consul BD : ' + trim(nrbd),trim(eldnicont)) );
   ReporteRst.ShowReport;
  except
    on E: Exception do EnviarLog(Self.Caption, 'Error en Reporte ' + E.Message);
  end;
  FreeAndNil(frxDB1);
  FreeAndNil(ReporteRst);
  FreeAndNil(DtsObjetos);
 end;
end;

