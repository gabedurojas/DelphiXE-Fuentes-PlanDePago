unit ActivaPPconAnticipos;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, StdCtrls, ComCtrls, DB, ADODB, Mask, Buttons, Grids, DBGrids,
  ExtCtrls, StrUtils, JvExDBGrids, JvDBGrid, JvgGroupBox, JvExButtons, JvBitBtn,
  ToolWin, JvExGrids, JvStringGrid, Menus, ImgList, JvDataEmbedded,Objetos,
  JvComponentBase, JvEmbeddedForms, JvExStdCtrls, JvGroupBox, frxClass,DBClient, MidasLib ,
  frxDBSet;

type THackStringGrid = class(TJvStringGrid);
type
  TActiva_PPconAnticipo = class(TForm)
    ToolBar1: TToolBar;
    ToolButton1: TToolButton;
    BORRA: TJvBitBtn;
    ToolButton3: TToolButton;
    SALE: TJvBitBtn;
    Barra1: TStatusBar;
    JvgGroupBox1: TJvgGroupBox;
    DataSource1: TDataSource;
    PC1: TPageControl;
    TabSheet3: TTabSheet;
    JvgGroupBox5: TJvgGroupBox;
    FormularioEmb: TJvEmbeddedFormLink;
    grillactabancos: TStringGrid;
    ImageList1: TImageList;
    frxReport1: TfrxReport;
    ToolButton2: TToolButton;
    Label2: TLabel;
    CheckBox1: TCheckBox;
    GroupBox1: TGroupBox;
    Buscar: TJvBitBtn;
    Ld: TDateTimePicker;
    JvBitBtn1: TJvBitBtn;
    elid: TEdit;
    Label11: TLabel;
    Label1: TLabel;
    plannro: TEdit;
    JvDBGrid1: TJvDBGrid;
    procedure FormCreate(Sender: TObject);
    procedure FormActivate(Sender: TObject);
