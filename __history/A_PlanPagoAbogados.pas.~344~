procedure TAlta_PlanPagoAbogados.CreaTablaTemporal();
var dmi,Fdsd,Fhta:string;
    tot:array of real;
    y,t,r:integer;
    ps, ps1:boolean;
begin
 try
  //Cargamos la tabla de Objetos desde la grilla5
  DtsGrilla2:=TClientDataSet.Create(nil);
  DtsGrilla2.FieldDefs.Clear;
  DtsGrilla2.Active:=False;
  with DtsGrilla2.FieldDefs.AddFieldDef do begin
    Name:='Rubro';
    DataType:=ftString;Size:=50;
  end;
  with DtsGrilla2.FieldDefs.AddFieldDef do begin
    Name:='Descripcion';
    DataType:=ftString;Size:=150;
  end;
  with DtsGrilla2.FieldDefs.AddFieldDef do begin
    Name:='Objeto';
    DataType:=ftString;Size:=18;
  end;
  with DtsGrilla2.FieldDefs.AddFieldDef do begin
    Name:='Periodo';
    DataType:=ftString;Size:=18;
  end;
  with DtsGrilla2.FieldDefs.AddFieldDef do begin
    Name:='Importe';DataType:=ftString;Size:=18;
  end;
  with DtsGrilla2.FieldDefs.AddFieldDef do begin
    Name:='IntDev';
    DataType:=ftString;Size:=18;
  end;
  with DtsGrilla2.FieldDefs.AddFieldDef do begin
    Name:='ElSubtotal';
    DataType:=ftString;Size:=18;
  end;
  with DtsGrilla2.FieldDefs.AddFieldDef do begin
    Name:='CapitalRef';
    DataType:=ftString;Size:=18;
  end;
  with DtsGrilla2.FieldDefs.AddFieldDef do begin
    Name:='IntRem';
    DataType:=ftString;Size:=18;
  end;
  with DtsGrilla2.FieldDefs.AddFieldDef do begin
     Name:='FechaDesde';
     DataType:=ftString;Size:=18;
  end;
  with DtsGrilla2.FieldDefs.AddFieldDef do begin
     Name:='FechaHasta';
     DataType:=ftString;Size:=18;
  end;
  with DtsGrilla2.FieldDefs.AddFieldDef do begin
    Name:='Saldo';
    DataType:=ftString;Size:=18;
  end;
  with DtsGrilla2.FieldDefs.AddFieldDef do begin
    Name:='CantPeriodos';
    DataType:=ftString;Size:=18;
  end;
  with DtsGrilla2.FieldDefs.AddFieldDef do begin
    Name:='TotalDesc';DataType:=ftString;Size:=18;
  end;
  with DtsGrilla2.FieldDefs.AddFieldDef do begin
    Name:='TotalFinal';
    DataType:=ftString;Size:=18;
  end;
  with DtsGrilla2.FieldDefs.AddFieldDef do begin
    Name:='SubRubro';
    DataType:=ftString;Size:=18;
  end;
  DtsGrilla2.CreateDataSet;
  DtsGrilla2.Active:=True;
  y:=1;
  dmi:='';
  SetLength(tot,9);
  for t:=0 to 8 do tot[t]:=0;
  Fdsd:='';
  ps:=true;ps1:=false;
  for t:=1 to grilla2.RowCount-1 do begin
    if ((trim(grilla2.Cells[0,t]) = Objetos.Rubro.Strings[y])
    or (trim(grilla2.Cells[0,t]) = '1120204') or (trim(grilla2.Cells[0,t]) = '1120205')
    or (trim(grilla2.Cells[0,t]) = '1120209'))
    and (trim(grilla2.Cells[1,t]) = trim(Objetos.CodObjeto.Strings[y])) then begin
     for r:=1 to grilla2.RowCount-1 do begin
      if Objetos.Identidad.Strings[y] = grilla2.Cells[13,r] then  begin
       ps1:=true;
       break;
      end;
     end;
     if ps1 then begin
       if ps then begin
        Fdsd:=grilla2.Cells[3,t];
        ps:=false;
       end;
      tot[0]:=tot[0] + StrToFloat(grilla2.Cells[4,t]);
      tot[1]:=tot[1] + StrToFloat(grilla2.Cells[5,t]);
      tot[2]:=tot[2] + StrToFloat(grilla2.Cells[6,t]);
      tot[3]:=tot[3] + StrToFloat(grilla2.Cells[7,t]);
      tot[4]:=tot[4] + StrToFloat(grilla2.Cells[8,t]);
      tot[5]:=tot[5] + StrToFloat(grilla2.Cells[9,t]);
      tot[6]:=tot[6] + 1;
      tot[7]:=tot[7] + StrToFloat(grilla2.Cells[11,t]);
      tot[8]:=tot[8] + StrToFloat(grilla2.Cells[12,t]);
     end;
    end;
    end;

    if ps1 then begin
     Fhta:='';
     ps:=true;
     for t:=grilla2.RowCount-1 downto 1 do begin
      if ((trim(grilla2.Cells[0,t]) = Objetos.Rubro.Strings[y])
      or (trim(grilla2.Cells[0,t]) = '1120204')  or (trim(grilla2.Cells[0,t]) = '1120205')
      or (trim(grilla2.Cells[0,t]) = '1120209'))
      and (trim(grilla2.Cells[1,t]) = trim(Objetos.CodObjeto.Strings[y])) then begin
       if ps then begin
        Fhta:=grilla2.Cells[3,t];
        ps:=false;
       end;
     end;
    end;
    DtsGrilla2.Append;
    DtsGrilla2.FieldValues['Rubro']:=Objetos.DetalleImpu.Strings[y];  //grilla2.Cells[0,0]:='SubRubro';
    DtsGrilla2.FieldValues['Descripcion']:=Objetos.Descripcion.Strings[y];  //grilla2.Cells[0,0]:='SubRubro';
    DtsGrilla2.FieldValues['Objeto']:=Objetos.CodObjeto.Strings[y];    //grilla2.Cells[1,0]:='Objeto';
    DtsGrilla2.FieldValues['Periodo']:='MULTIPLES';   //grilla2.Cells[2,0]:='Periodo';
    DtsGrilla2.FieldValues['Importe']:=tot[0];   //grilla2.Cells[4,0]:='Capital';
    DtsGrilla2.FieldValues['IntDev']:=tot[1];    //grilla2.Cells[5,0]:='Interés';
    DtsGrilla2.FieldValues['ElSubtotal']:=tot[2];   //grilla2.Cells[6,0]:='Sub-Total';
    DtsGrilla2.FieldValues['CapitalRef']:=tot[3];   //grilla2.Cells[7,0]:='Sub-Total';
    DtsGrilla2.FieldValues['IntRem']:=tot[4];    //grilla2.Cells[8,0]:='Interés Ref.';
    DtsGrilla2.FieldValues['Saldo']:=tot[5];     //grilla2.Cells[9,0]:='Sub-Total Ref.';
    DtsGrilla2.FieldValues['CantPeriodos']:=tot[6];   //grilla2.Cells[10,0]:='% Descuento';
    DtsGrilla2.FieldValues['TotalDesc']:=tot[7];   //grilla2.Cells[11,0]:='Total Desc.';
    DtsGrilla2.FieldValues['TotalFinal']:=tot[8];   //grilla2.Cells[12,0]:='Total Final';
    DtsGrilla2.FieldValues['SubRubro']:=Objetos.Rubro.Strings[y];   //grilla2.Cells[12,0]:='Total Final';
    DtsGrilla2.FieldValues['FechaDesde']:=Fdsd;
    DtsGrilla2.FieldValues['FechaHasta']:=Fhta;
    DtsGrilla2.Post;
  end;
 except
  on E: Exception do EnviarLog(Self.Caption, E.Message);
 end;
end;

