  calle.Enabled:=false;                ALTURA1.Enabled:=false;
  PISO1.Enabled:=false;                DPTO1.Enabled:=false;
  MANZANA1.Enabled:=false;             CASA1.Enabled:=false;
  TORRE1.Enabled:=false;               SECTOR1.Enabled:=false;
  PARCELA1.Enabled:=false;             LOTERURAL1.Enabled:=false;
  TELEFONO.Enabled:=false;             DOMI1.Enabled:=false;
  mail.Enabled:=false;                 caracter.Enabled:=false;
end;
