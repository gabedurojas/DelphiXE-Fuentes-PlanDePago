Function TAlta_PlanPagoAbogados.Verificacion(nro:byte):boolean;
var Form1:TForm;
    E1:TRichEdit;
    txt:string;
    r:extended;
    d:integer;
begin
  //  ordenagrilla(grilla4,16);  // ordenamos la grilla asi el titular siempre esta primero
  if Assigned(Form1) then FreeAndNil(Form1);
  Application.CreateForm(TForm, Form1);
  Form1.Width:=530;
  Form1.Height:=320;
  Form1.Caption:='Errores Encontrados en Ventana';
  Form1.Position:=poDeskTopCenter;
  E1:=TRichEdit.Create(self);
  E1.Parent:=Form1;
  E1.Color:=clNavy;
  E1.Font.Color:=clYellow;
  E1.Font.Size:=10;
  E1.Top:=0;
  E1.Left:=0;
  E1.Align:=alClient;
  E1.Clear;
  E1.ReadOnly:=true;
  if nro = 1 then begin
   if trim(IDCONT.Text) = '' then E1.Lines.Add('Identidad del Contribuyente vacío');
   if trim(NOMBRE.Text) = '' then E1.Lines.Add('Nombre del Contribuyente vacío');
   if trim(GRILLA1.Cells[0,1]) =  '' then E1.Lines.Add('Grilla de Objetos vacía');
   if trim(grilla2.Cells[0,1]) =  '' then E1.Lines.Add('Grilla de Periodos vacía');
   if trim(VALSELLADO.Text) = '' then E1.Lines.Add('Sellado vacío');
   if trim(VENC1.Text) = '/  /' then E1.Lines.Add('Fecha de Inicio vacío');
   if trim(VENC2.Text) = '/  /' then E1.Lines.Add('Fecha de Fín vacío');
   if trim(GRILLA5.Cells[0,1]) =  '' then E1.Lines.Add('Grilla de Cuotas vacía. ');
   if trim(GRILLA4.Cells[0,1]) =  '' then E1.Lines.Add('Grilla de Contribuyentes vacía');
  end;
  if (nro = 2) or (nro = 3) then begin
   if (trim(CONTRIB.Text) = '') or (Length(trim(CONTRIB.Text)) < 5) then E1.Lines.Add('Debe Seleccionar un Contribuyente');
   if (trim(TELEFONO.Text) = '') or (trim(TELEFONO.Text) = '0') then E1.Lines.Add('Debe completar el N° Teléfono');
   if (nro = 2) then begin
    if (trim(Grilla4.Cells[1,1]) = '') then begin
     if (trim(CARACTER.Text) <> 'TITULAR') then E1.Lines.Add('El primer contribuyente debe ser TITULAR');
     if (trim(CUIM.Text) <> CuimTit) then E1.Lines.Add('El 1er Contribuyente debe ser el Titular de la Deuda');
    end
    else begin
     if (trim(CARACTER.Text) = 'TITULAR') and (trim(Grilla4.Cells[16,1]) = 'TITULAR') then E1.Lines.Add('Ya existe el caracter TITULAR');
     if (grilla4.Cells[0,1] <> CuimTit) then E1.Lines.Add('El 1er Contribuyente debe ser el Titular de la Deuda');
    end;
   end;
   if (nro = 3) then begin
    if grilla4.Row = 1 then begin
     if (trim(CUIM.Text) <> CuimTit) then E1.Lines.Add('El 1er Contribuyente debe ser el Titular de la Deuda');
     if (trim(CARACTER.Text) <> 'TITULAR') then E1.Lines.Add('El primer contribuyente debe ser TITULAR');
    end;
   end;
   if trim(ALTURA1.Text) = '' then E1.Lines.Add('Debe completar la Altura. Si no la tiene complete con CERO');
   if PROVINCIA.ItemIndex < 0 then E1.Lines.Add('Provincia inválida');
   if BARRIO.ItemIndex < 0 then E1.Lines.Add('Barrio inválido');
   if CALLE.ItemIndex < 0 then E1.Lines.Add('Calle inválida');
   if CARACTER.ItemIndex < 0 then E1.Lines.Add('Caracter inválido');
   if trim(MAIL.Text) <> '' then
   if not UNidad.emailValido(trim(MAIL.Text))then E1.Lines.Add('El Mail del contribuyente es erroneo');
  end;
  if E1.Lines.Count > 0 then begin
   Form1.Show;
   Result:=false;
  end
  else begin
   FreeAndNil(Form1);
   Result:=true;
  end;
end;

