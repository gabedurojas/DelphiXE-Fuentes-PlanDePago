procedure TAlta_PlanPagoAbogados.Limpiar(nro:byte);
var t,y:integer;
begin
if nro <= 0 then begin
  Limpiado:=true;
  for t:=1 to grilla1.RowCount-1 do
    for y:=0 to grilla1.ColCount-1 do grilla1.Cells[y,t]:='';
  grilla1.RowCount:=2;

  for t:=1 to grilla2.RowCount-1 do
    for y:=0 to grilla2.ColCount-1 do grilla2.Cells[y,t]:='';
  grilla2.RowCount:=2;

  for t:=1 to grilla5.RowCount-1 do
    for y:=0 to grilla5.ColCount-1 do grilla5.Cells[y,t]:='';
  grilla5.RowCount:=2;

  for t:=1 to grilla4.RowCount-1 do
    for y:=0 to grilla4.ColCount-1 do grilla4.Cells[y,t]:='';
  grilla4.RowCount:=2;
  ColocaCombo(5);
  CAPITAL.Text:='0.00';
  INTERESDEV.Text:='0.00';
  INTERESREM.Text:='0.00';
  SUBTOTAL.Text:='0.00';
  TOTAL.Text:='0.00';
  CUOTAS.ItemIndex:=0;
  VENC1.Text:=FechaAct;
  VENC2.Clear;
  Sellado.Enabled:=false;
  CONDPLAN.Enabled:=false;
  CONTRPLAN.Enabled:=false;
  FINPLAN.Enabled:=false;
end;
