if nro=4 then Modulo2.CargaCombo(CUOTAS,'select NroCuota,Id from Fn_PlanPagoCuotasBD (' + chr(39) + RubrosInc + chr(39) + ')',Modulo2.Sistema.ConectDb, false);
if nro=5 then Modulo2.CargaCombo(CARACTER,'SELECT Detalle ,Id FROM TipoContribuyente',Modulo2.Sistema.ConectDb, false);
end;

