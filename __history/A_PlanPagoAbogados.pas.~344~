  PARCELA1.Clear;                 LOTERURAL1.Clear;
  TELEFONO.Clear;                 DOMI1.Clear;
  CARACTER.ItemIndex:=0;          OBSERV.Clear;
  mail.Clear;                     //ARBOL.Items.Clear;
  IDCOnt.Clear;NOMBRE.Clear;
  PC1.ActivePage:=PC1.Pages[0];
  PB2.Position:=0;
  PG1.Position:=0;
  pc1.Pages[1].TabVisible:=false;
end;
if nro=2 then begin
  ColocaCombo(1);                  ColocaCombo(2);
  ColocaCombo(3);                 //   ColocaCombo(8);
  CUIM.Clear;                      contribid.Clear;
  CONTRIB.Clear;                   ALTURA1.Text:='0';
  PISO1.Clear;                     DPTO1.Clear;
  MANZANA1.Clear;                  CASA1.Clear;
  TORRE1.Clear;                    SECTOR1.Clear;
  PARCELA1.Clear;                  LOTERURAL1.Clear;
  TELEFONO.Clear;                  DOMI1.Clear;
  mail.Clear;
end;
if nro=3 then begin
  CUIM.Clear;
  contribid.Clear;
  CONTRIB.Clear;
