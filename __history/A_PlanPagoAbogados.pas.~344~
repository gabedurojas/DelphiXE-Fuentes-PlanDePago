procedure TAlta_PlanPagoAbogados.Agrega2Click(Sender: TObject);
var t:integer;

  function busca():boolean;
    var p:integer;
  begin
  Result:=true;
  if grilla4.Cells[0,1] <> '' then begin
    for p:=1 to grilla4.RowCount-1 do
      if (grilla4.Cells[0,p]=trim(CUIM.Text))
      and (grilla4.Cells[1,p]=trim(CONTRIB.Text))
      and (grilla4.Cells[16,p]=trim(CARACTER.Text)) then Result:=false;
    end;
  end;

begin
 if busca then begin
  if Verificacion(2) then begin
    if (grilla4.RowCount > 1) and (trim(grilla4.Cells[0,1])<>'') then begin
     t:=grilla4.RowCount;
      grilla4.RowCount:=grilla4.RowCount+1;
    end
    else t:=1;
    if t=3 then begin
     messagedlg('ATENCION... Grilla Completa!' + Chr(13)+'Imposible seguir agregando Contribuyentes',mterror,[mbok],0);
     grilla4.RowCount:=grilla4.RowCount-1;
     agrega2.SetFocus;
    end
    else begin
     if (t = 1) and (CuimTit <> trim(CUIM.Text)) then
      messagedlg('ERROR!!.. Los datos del titular de los objetos no coincide con el que se intenta cargar',mtError,[mbOk],0)
     else begin
      grilla4.Cells[0,t]:=trim(CUIM.Text);
      grilla4.Cells[1,t]:=AnsiReplaceStr(trim(CONTRIB.Text),chr(39),chr(33));
      grilla4.Cells[2,t]:=trim(PROVINCIA.Text);
      grilla4.Cells[3,t]:=trim(BARRIO.Text);
      grilla4.Cells[4,t]:=trim(CALLE.Text);
      if trim(ALTURA1.Text)='' then grilla4.Cells[5,t]:='0'
       else grilla4.Cells[5,t]:=trim(ALTURA1.Text);
      grilla4.Cells[6,t]:=trim(PISO1.Text);
      grilla4.Cells[7,t]:=trim(DPTO1.Text);
      grilla4.Cells[8,t]:=trim(MANZANA1.Text);
      grilla4.Cells[9,t]:=trim(CASA1.Text);
      grilla4.Cells[10,t]:=trim(TORRE1.Text);
      grilla4.Cells[11,t]:=trim(SECTOR1.Text);
      grilla4.Cells[12,t]:=trim(PARCELA1.Text);
      grilla4.Cells[13,t]:=trim(LOTERURAL1.Text);
      grilla4.Cells[14,t]:=trim(TELEFONO.Text);
      grilla4.Cells[15,t]:=AnsiReplaceStr(trim(DOMI1.Text),chr(39),chr(33));
      if t = 1 then begin
       grilla4.Cells[16,t]:='TITULAR';
       grilla4.Cells[21,t]:='1';
      end
      else begin
       grilla4.Cells[16,t]:=trim(CARACTER.Text);
       grilla4.Cells[21,t]:=TComboClase(CARACTER.Items.Objects[CARACTER.ItemIndex]).Param1;
      end;
      grilla4.Cells[17,t]:=DniTit;
      grilla4.Cells[18,t]:=TComboClase(PROVINCIA.Items.Objects[PROVINCIA.ItemIndex]).Param1;
      grilla4.Cells[19,t]:=TComboClase(BARRIO.Items.Objects[BARRIO.ItemIndex]).Param1;
      grilla4.Cells[20,t]:=TComboClase(CALLE.Items.Objects[CALLE.ItemIndex]).Param1;
      if trim(Contribid.Text)='' then  grilla4.Cells[22,t]:='null'
        else grilla4.Cells[22,t]:=trim(Contribid.Text);
      grilla4.Cells[23,t]:=trim(mail.Text);
     end;
    end;
    GUARDA.Enabled:=true;
    LIMPIAR(2);
    caracter.ItemIndex :=0;
    DniTit:='';
    //BUSCACUIM.SetFocus;
    GUARDA.SetFocus;
  end;
 end
 else begin
  messagedlg('ERROR!!.. No se PERMITE mismo Contribuyente Titular y Resp. Pago',mtError,[mbOk],0);
  buscacuim.SetFocus;
 end;
end;

