procedure TAlta_PlanPagoAbogados.Exportar1Click(Sender: TObject);
var txt1:widestring;
    t,y:integer;
begin
  RE.Clear;
  txt1:='';
  for y:=0 to grilla2.ColCount-1 do
    txt1:=txt1 + grilla2.Cells[y,0] + chr(9);
  RE.Lines.Append(txt1);
  for t:=1 to grilla2.RowCount-1 do begin
    txt1:='';
    for y:=0 to grilla2.ColCount-1 do
      txt1:=txt1 + grilla2.Cells[y,t] + chr(9);
    RE.Lines.Append(txt1);
  end;
  RE.SelectAll;
  RE.CopyToClipboard;
  messagedlg('Datos Copiados Correctamante!!' + chr(13) + 'Abra Excel y pegue los datos en la hoja activa...',mtWarning,[mbok],0)
end;

