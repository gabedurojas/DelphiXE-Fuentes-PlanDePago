 Recibo.NroPlan:=NroPlan;
 Recibo.NroCuota:=CUOTAS.Text;
 Recibo.FechaIni:=VENC1.Text;
 y:=1;
 dmi:=LeftStr(dmi,Length(dmi)) ;
 Recibo.CantObj:=IntToStr(y-1);
 Recibo.Objetos:=dmi;
 Recibo.PrimerV:=trim(VENC1.Text);
 Recibo.SegundoV:=trim(VENC1.Text);
 Recibo.NroUsuario:=Modulo2.Usuario.UsuNro;
 try
  Cnx2:=TADOConnection.Create(nil);
  Cnx2.LoginPrompt:=false;
  Cnx2.ConnectionString:=Modulo2.Sistema.ConectUsu;
  DataSet3:=TADODataSet.Create(nil);
