  provincia.Enabled:=true;            barrio.Enabled:=true;
  calle.Enabled:=true;                ALTURA1.Enabled:=true;
  PISO1.Enabled:=true;                DPTO1.Enabled:=true;
  MANZANA1.Enabled:=true;             CASA1.Enabled:=true;
  TORRE1.Enabled:=true;               SECTOR1.Enabled:=true;
  PARCELA1.Enabled:=true;             LOTERURAL1.Enabled:=true;
