 if nro = 1 then begin
  //valor:= trim(total.Text);
  //valor1:=strtofloat(valor);
  //if valor1 > 50000 then begin
  // valor2 := (valor1 * 16)/100 ;
  // VALSELLADOABOGADO := floattostr(valor2);
