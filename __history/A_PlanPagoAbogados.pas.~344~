 end;
 dmi:='';
 tmp:='';
 if nro = 1 then begin //Caso del Recibo de Cuota
  Recibo.TituloDesc:='ACTIVIDAD ADMINISTRATIVA Y SELLOS';
  Recibo.CuotaDe:='UNICA';
  Recibo.DetalleRecibo:='GASTOS DE GESTION DIRECTA DE DEUDA POR LA PROCURACION';
