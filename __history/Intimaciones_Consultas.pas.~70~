procedure TConsultas_Intimaciones.exportaClick(Sender: TObject);
var t,p,a:integer;
   texto:string;
begin
 a:=messagedlg('Desea Exportar a Excel las Intimaciones de este Lote seleccionado?',mtWarning,[mbok,mbCancel],0);
 if a = 1 then begin
  todos.Clear;
  todos.Lines.Add('');
  todos.Lines.Add('RESUMEN DE LOTES DE INTIMACIONES GENERADOS');
  for t:=0 to grilla1.RowCount -1   DO BEGIN
   texto:='';
   for p:=0 to grilla1.ColCount - 1 do begin
    texto:= texto + grilla1.Cells[p,t] + chr(9);
   end;
   todos.Lines.Add(texto);
  end;
  todos.SelectAll;
  todos.CopyToClipboard;
  messagedlgpos('Datos Procesados y Listos para pegarlos a Excel',mtwarning,[mbok],0,screen.Width div 3,screen.Height div 3);
  PC1.ActivePage:=PC1.Pages[0];
 end;
end;

