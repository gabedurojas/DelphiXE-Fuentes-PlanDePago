Function TComercioDDJJOficio.Consultas(nro: byte):string;
var t, y:integer;
    valor:string;
    comando:widestring;
    Cnx1:TADOConnection;
    DataSet2: TADODataSet;
begin
 if nro = 1 then begin
  try
    Cnx1:=TADOConnection.Create(nil);
    Cnx1.LoginPrompt:=false;
    Cnx1.ConnectionString:=Modulo2.Sistema.ConectComercio;

    DataSet1.Close;
    DataSet1.Connection:=Cnx1;
    for t:=1 to grilla1.RowCount-1 do
      for y:=0 to grilla1.ColCount-1 do grilla1.Cells[y,t]:='';

    comando:='SELECT Id, Fecha, Periodo, BaseImponible, Interes, Monto, IdInscripcion, '
    + 'Comentario, FECHABLQ FROM ComerciosDeudas WHERE (IDTH = ' + IDTH.Text + ') AND (Periodo = '
    + PERIO.Text + ') AND (FechaBaja IS NULL)';
    DataSet1.CommandText:=comando;
    DataSet1.Open;
    DataSet1.Connection:=nil;
    Result:='';
  except
    messagedlg('Error al Conectar al Servidor',mterror,[mbok],0);
  end;
 end;
 if nro = 2 then begin
  try
    Cnx1:=TADOConnection.Create(nil);
    Cnx1.LoginPrompt:=false;
    Cnx1.ConnectionString:=Modulo2.Sistema.ConectComercio;
    ConDet := false;

    DataSet2:=TADODataSet.Create(nil);
    DataSet2.Connection:=Cnx1;

    comando:='SELECT B.IdActividad, B.CodRenta, B.Concepto, A.BaseImponible, '
    + 'A.Alicuota, A.Minimo, A.Id FROM ComerciosDeudasDet A INNER JOIN TiposActividades B ON '
    + 'A.IdClasificacionActividad = B.IdActividad WHERE (IdDeuda = ' + DataSet1.FieldByName('Id').AsString
    + ') ORDER BY A.ID;';
    DataSet2.CommandText:=comando;
    DataSet2.Open;
    {grilla1.Cells[0,0]:='N° Orden';
  grilla1.Cells[1,0]:='N° Act';
  grilla1.Cells[2,0]:='Cod. Rentas';
  grilla1.Cells[3,0]:='Descripción';   //    Imp. Cuota
  grilla1.Cells[4,0]:='Base Imponible';      //    Capital
  grilla1.Cells[5,0]:='Alicuota';      //    Interes
  grilla1.Cells[6,0]:='Minimo';
  grilla1.Cells[7,0]:='Id';
  grilla1.Cells[8,0]:='Mdf';}

    for t:=1 to DataSet2.RecordCount do begin
      DataSet2.RecNo:=t;
      grilla1.RowCount:=t+1;
      grilla1.Cells[0,t]:=IntToStr(t);
      grilla1.Cells[1,t]:=DataSet2.FieldByName('IdActividad').AsString;
      grilla1.Cells[2,t]:=DataSet2.FieldByName('CodRenta').AsString;
      grilla1.Cells[3,t]:=DataSet2.FieldByName('Concepto').AsString;
      grilla1.Cells[4,t]:=DataSet2.FieldByName('BaseImponible').AsString;
      grilla1.Cells[5,t]:=DataSet2.FieldByName('Alicuota').AsString;
      grilla1.Cells[6,t]:=DataSet2.FieldByName('Minimo').AsString;
      grilla1.Cells[7,t]:=DataSet2.FieldByName('Id').AsString;
    end;


    DataSet2.Connection:=nil;
    FreeAndNil(DataSet2);
    Result:='';
  except
    messagedlg('Error al Conectar al Servidor',mterror,[mbok],0);
  end;
 end;

 FreeAndNil(Cnx1);
end;


procedure TComercioDDJJOficio.IDTHExit(Sender: TObject);
begin
if trim(IDTH.Text) = '' then begin
  messagedlg('El ID de TH no puede estar vacío',mtError,[mbok],0);
  IDTH.SetFocus;
end;

end;

procedure TComercioDDJJOficio.IDTHKeyPress(Sender: TObject; var Key: Char);
