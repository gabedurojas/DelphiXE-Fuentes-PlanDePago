{grilla1.Cells[0,0]:='N° Orden';
  grilla1.Cells[1,0]:='N° Act';
  grilla1.Cells[2,0]:='Cod. Rentas';
  grilla1.Cells[3,0]:='Descripción';   //    Imp. Cuota
  grilla1.Cells[4,0]:='Base Imponible';      //    Capital
