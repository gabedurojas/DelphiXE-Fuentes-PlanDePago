procedure TComercioDDJJOficio.BORRAClick(Sender: TObject);
var t,y:integer;
begin
ConDet := false;
for t:=1 to grilla1.RowCount-1 do
  for y:=0 to grilla1.ColCount-1 do grilla1.Cells[y,t]:='';
BASEIMP.Text:='0';
MOTIVO.Clear;
DataSet1.Close;
MODIF1.Enabled:=false;
GUARDA.Enabled:=false;
end;

procedure TComercioDDJJOficio.GUARDAClick(Sender: TObject);
var t: integer;
    Cnx1:TADOConnection;
    DataSet2: TADODataSet;
    Com1:TADOCommand;
    Comando:widestring;
    BaseImponible, Id:string;
begin
t:=messagedlg('Desea GUARDAR los Datos de esta DDJJ de Oficio?',mtInformation,[mbok,mbCancel],0);
if t = 1 then begin
  try
    Cnx1:=TADOConnection.Create(nil);
    Cnx1.LoginPrompt:=false;
    Cnx1.ConnectionString:=Modulo2.Sistema.ConectComercio;

    Com1:=TADOCommand.Create(nil);
    Com1.Connection:=Cnx1;


    if not EsModif then begin
      if ConDet then begin
        DataSet2:=TADODataSet.Create(nil);
        DataSet2.Connection:=Cnx1;

        Comando := 'SPA_ComerciosDeudasDdjjOficio '
        + DataSet1.FieldByName('Id').AsString + ' , '
        + DataSet1.FieldByName('IdTH').AsString + ' , '
        + DataSet1.FieldByName('Periodo').AsString + ' , '
        + chr(39) + FechaAct + chr(39) + ' , '
        + BaseImponible + ' , 0 , ' + BaseImponible + ' , '
        + DataSet1.FieldByName('IdInscripcion').AsString + ' , '
        + chr(39) + trim(MOTIVO.Text) + chr(39) + ' , '
        + modulo2.Usuario.UsuNro;
        DataSet2.CommandText := Comando;
        DataSet2.Open;
        Id := DataSet2.FieldByName('Id').AsString;
        {grilla1.Cells[0,0]:='N° Orden';
        grilla1.Cells[1,0]:='N° Act';
        grilla1.Cells[2,0]:='Cod. Rentas';
        grilla1.Cells[3,0]:='Descripción';   //    Imp. Cuota
        grilla1.Cells[4,0]:='Base Imponible';      //    Capital
        grilla1.Cells[5,0]:='Alicuota';      //    Interes
        grilla1.Cells[6,0]:='Minimo';
        grilla1.Cells[7,0]:='Id';
        grilla1.Cells[8,0]:='Mdf';}
        for t:=1 to grilla1.RowCount-1 do begin
          Comando := 'SPA_ComerciosDeudasDetDdjjOficio '
          + Id + ' , '
          + ' , ' + grilla1.Cells[4,t]
          + ' , ' + grilla1.Cells[5,t]
          + ' , ' + grilla1.Cells[6,t]
          + ' , ' + grilla1.Cells[1,t];
          Com1.CommandText := Comando;
          Com1.Execute;
        end;
        DataSet2.Close;
        FreeAndNil(DataSet2);

        Application.ProcessMessages;
        messagedlg('Los datos de la DDJJ de Oficio se han guardado correctamente!!',mtConfirmation,[mbok],0);
      end
      else messagedlg('Solo se puede generar un DDJJ de Oficio si ha cambiado algún valor de Base Imponible',mterror,[mbok],0);
    end
    else begin
      Comando := 'SPM_ComerciosDeudasDdjjOficio '
      + DataSet1.FieldByName('Id').AsString + ' , '
      + BaseImponible + ' , 0 , ' + BaseImponible + ' , '
      + chr(39) + trim(MOTIVO.Text) + chr(39);
      Com1.CommandText := Comando;
      Com1.Execute;

      for t:=1 to grilla1.RowCount-1 do begin
        Comando := 'SPM_ComerciosDeudasDetDdjjOficio '
        + Id + ' , '
        + ' , ' + grilla1.Cells[4,t];
        Com1.CommandText := Comando;
        Com1.Execute;
      end;

      Application.ProcessMessages;
      messagedlg('Los datos de la DDJJ de Oficio se han Modificado correctamente!!',mtConfirmation,[mbok],0);
    end;

  except
    on E: Exception do EnviarLog(Self.Caption, E.Message);
 end;
end;
end;




