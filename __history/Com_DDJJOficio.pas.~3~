if trim(DataSet1.FieldByName('FECHABLQ').AsString) = '' then begin
  JvDBGrid1.Canvas.Brush.Color:=clWindow;
  JvDBGrid1.Canvas.FillRect(Rect);
  JvDBGrid1.Canvas.Font.Color:= clBlack;
end
else begin
  JvDBGrid1.Canvas.Brush.Color:=$00CECEFF;
  JvDBGrid1.Canvas.FillRect(Rect);
  JvDBGrid1.Canvas.Font.Color:= clBlack;
end;
JvDBGrid1.DefaultDrawColumnCell(Rect,Datacol,Column,State);
end;

