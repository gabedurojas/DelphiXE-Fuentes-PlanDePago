        object Memo12: TfrxMemoView
          AllowVectorExport = True
          Left = 3.952690000000000000
          Top = 269.567100000000000000
          Width = 710.551640000000000000
          Height = 317.480520000000000000
          Font.Charset = DEFAULT_CHARSET
          Font.Color = clBlack
          Font.Height = -11
          Font.Name = 'Arial'
          Font.Style = []
          Frame.Typ = []
          HAlign = haBlock
          Memo.UTF8W = (
            
              '                              [LugarFecha], VISTO'#8230' CONSIDERANDO:' +
              ' Que conforme a las compulsas realizadas por la Administraci'#243'n d' +
              'e Ingresos Municipales, no existen constancias de pago de los sa' +
              'ldos adeudados por los contribuyentes citados en el Anexo I, en ' +
              'relaci'#243'n a los periodos y tributos detallados en las Boletas de ' +
              'Deudas que se incluyen en el Anexo I, correspondiendo en consecu' +
              'encia efectuar la emisi'#243'n de las Boletas de Deudas, por las deud' +
              'as de los tributos con mas sus accesorios legales'#8230' Que los citad' +
              'os saldos'#8230' surgen por la falta de pagos (total o parcial) de las' +
              ' Tasas, Derechos, Contribuciones y dem'#225's Tributos Municipales. Q' +
              'ue el Art. 14 del C'#243'digo Tributario dispone: '#8220'La Administraci'#243'n ' +
              'de Ingresos Municipales se denominar'#225' en este C'#243'digo, organismo ' +
              'fiscal. Todas las funciones y facultades atribuidas por este C'#243'd' +
              'igo y por otras ordenanzas tributarias al organismo fiscal, ser'#225 +
              'n ejercidas por la Directora de la Administraci'#243'n de Ingresos Mu' +
              'nicipales con dependencia funcional y jer'#225'rquica respecto de la ' +
              'Secretar'#237'a de Hacienda'#8230' el Art. 15 del C'#243'digo Tributario Municip' +
              'al-Ordenanza N'#176' 7147/17, expresa que '#8220'El organismo fiscal'#8230' podr'#225 +
              ' asimismo dictar resoluciones generales obligatorias, establecer' +
              ' deberes formales para contribuyentes, responsables y terceros y' +
              ' el modo en que deber'#225'n cumplirse los mismos'#8230' el Art. 16 del pre' +
              'sente C'#243'digo establece: '#8220'El organismo fiscal tiene a su cargo la' +
              's siguientes funciones: a) La verificaci'#243'n, fiscalizaci'#243'n, deter' +
              'minaci'#243'n y recaudaci'#243'n de la obligaci'#243'n tributaria y sus accesor' +
              'ios'#8230' d) La fiscalizaci'#243'n de los tributos que se determinan, liqu' +
              'idan y/o recaudan por otras oficinas municipales, como as'#237' tambi' +
              #233'n la reglamentaci'#243'n de los sistemas de retenci'#243'n, percepci'#243'n y ' +
              'recaudaci'#243'n, con control de los mismos'#8230'Que en el Libro I- Parte ' +
              'General, T'#237'tulo II del C'#243'digo Tributario Municipal- Ordenanza N'#176 +
              ' 7147/17, en su Art. 21, regula respecto del Cobro Judicial de l' +
              'os Tributos Municipales, facultando al Organismo Fiscal a proced' +
              'er al cobro judicial por v'#237'a ejecutiva de los impuestos, derecho' +
              's, tasas, contribuciones, sus intereses, recargos, actualizacion' +
              'es y multas y todo otro cr'#233'dito fiscal, una vez vencidos los pla' +
              'zos generales o especiales para el pago, sin necesidad de intima' +
              'ci'#243'n o requerimiento individual alguno. Que por todo lo expuesto' +
              ' es necesario dictar el acto administrativo de rigor, por ello: ' +
              'LA DIRECTORA DE LA ADMINISTRACION DE INGRESOS MUNCIPALES DEPENDI' +
              'ENTE DE LA SECRETAR'#205'A DE HACIENDA  DISPONE: ARTICULO 1'#176') L'#205'BRESE' +
              ' las BOLETAS DE DEUDA N'#176' [Desde] a N'#176' [Hasta] (ANEXO I), por los' +
              ' Tributos Municipales y periodos adeudados por los contribuyente' +
              's incluidos en el ANEXO I, con el fin de obtener el cobro de dic' +
              'has deudas, en virtud de lo prescripto por los Art. 14, 15, 16, ' +
              '21 y del Libro II de la Ordenanza N'#176' 7147/17, C'#243'digo Tributario ' +
              'Municipal, como se detalla en el Considerando. ARTICULO 2'#176') REM'#205 +
              'TASE en cumplimiento de lo dispuesto por los Art. 14 y 21 de la ' +
              'Ordenza N'#186' 7147/17, las Boletas de Deuda libradas por la present' +
              'e Disposici'#243'n, a la Unidad Legal, T'#233'cnica y Procuraci'#243'n Municipa' +
              'l, a los efectos de continuar con el tr'#225'mite de cobro por la v'#237'a' +
              ' de Apremio. ARTICULO 3'#176') COMUN'#205'QUESE, Reg'#237'strese, Cumplido ARCH' +
              #205'VESE.')
          ParentFont = False
        end
