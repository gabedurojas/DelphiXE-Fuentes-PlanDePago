procedure TAM_Pagares.Coloca1(nro:byte);
var t,j:integer;
var tot,tot1:real;
var Seleccion_Contribu: TSeleccion_Contribu;
begin
if nro = 2 then begin
  DataSet1:=TADODataSet.Create(nil);
  DataSet1.ConnectionString:=modulo2.Sistema.ConectDb;
  DataSet1.CommandText:='SELECT NroCuim,Nombre,TipoDoc,DNI,Provincia,Barrio,Calle,'
  + 'Puerta,Piso,Dpto,Manzana,Casa,Torre,Sector,Parcela,LoteRural,Domicilio,'
  + 'TipoContribuyente FROM Fn_PlanPagoPagare(' + chr(39) + trim(CUIM1.Text) + chr(39) + ');';
  DataSet1.Open;
  if DataSet1.RecordCount <> 0 then begin
    Seleccion_Contribu:= TSeleccion_Contribu.create(self);
    try
      for t:=1 to DataSet1.RecordCount do begin
        DataSet1.RecNo:=t;
        Seleccion_Contribu.grilla4.RowCount:=t+1;
        Seleccion_Contribu.grilla4.Cells[0,t]:=DataSet1.Fields[0].AsString;
        Seleccion_Contribu.grilla4.Cells[1,t]:=DataSet1.Fields[1].AsString;
        Seleccion_Contribu.grilla4.Cells[2,t]:=DataSet1.Fields[16].AsString;
        Seleccion_Contribu.grilla4.Cells[3,t]:=DataSet1.Fields[3].AsString;
        Seleccion_Contribu.grilla4.Cells[4,t]:=DataSet1.Fields[17].AsString;
      end;
      Seleccion_Contribu.ShowModal;
      t:=Seleccion_Contribu.fila;
    finally
       Seleccion_Contribu.Free;
    end;
    DataSet1.RecNo:=t;
    TPODOC.Text:=trim(DataSet1.Fields[2].AsString);
    DNI.Text:=trim(DataSet1.Fields[3].AsString);
    PROVINCIA.Text:=trim(DataSet1.Fields[4].AsString);
    BARRIO1.Text:=trim(DataSet1.Fields[5].AsString);
    CALLE1.Text:=trim(DataSet1.Fields[6].AsString);
    ALTURA1.Text:=trim(DataSet1.Fields[7].AsString);
    PISO1.Text:=trim(DataSet1.Fields[8].AsString);
    DPTO1.Text:=trim(DataSet1.Fields[9].AsString);
    MANZANA1.Text:=trim(DataSet1.Fields[10].AsString);
    CASA1.Text:=trim(DataSet1.Fields[11].AsString);
    TORRE1.Text:=trim(DataSet1.Fields[12].AsString);
    SECTOR1.Text:=trim(DataSet1.Fields[13].AsString);
    PARCELA1.Text:=trim(DataSet1.Fields[14].AsString);
    LOTERURAL1.Text:=trim(DataSet1.Fields[15].AsString);
    DOMI1.Text:=AnsiReplaceStr(trim(DataSet1.Fields[16].AsString),chr(33),chr(39));
    CARACTER.Text:=trim(DataSet1.Fields[17].AsString);
    Agrega_T.Enabled:=true;
  end
  else begin
    messagedlg('Error!! El Contribuyente Seleccionado no posee ningun Plan de Pagos' + chr(13)
     + 'Imposible Determinar el CARACTER del Mismo.',mterror,[mbok],0);
     BUSCUIM1.SetFocus;
  end;
  DataSet1.Close;
  FreeAndNil(DataSet1);
end;
if nro = 3 then begin
  Agrega.Enabled:=false;
  for t:=0 to grilla2.ColCount-1 do
    for j:=1 to grilla2.RowCount-1 do grilla2.Cells[t,j]:='';
  grilla2.RowCount:=2;
  DataSet1:=TADODataSet.Create(nil);
  DataSet1.ConnectionString:=modulo2.Sistema.ConectDb;
  DataSet1.CommandText:='SELECT NroPlan,FechaCreacion,CuotasOrig,CuotasAdeudadas,'
  + 'ImporteDeuda,ImportePagare from Fn_PlanPagoCalculoPagare (' + chr(39) + trim(CUIM1.Text)
  + chr(39) + ') ORDER BY NroPlan';
  DataSet1.Open;
  if DataSet1.RecordCount <> 0 then begin
    tot:=0;tot1:=0;
    for t:=1 to DataSet1.RecordCount do begin
      DataSet1.RecNo:=t;
      grilla2.RowCount:=t+1;
      grilla2.Cells[0,t]:=completa1(inttostr(t),2,'0');
      grilla2.Cells[1,t]:=trim(DataSet1.FieldByName('NroPlan').AsString);
      grilla2.Cells[2,t]:=strcut(trim(DataSet1.FieldByName('FechaCreacion').AsString),10);
      grilla2.Cells[3,t]:=trim(DataSet1.FieldByName('CuotasOrig').AsString);
      grilla2.Cells[4,t]:=trim(DataSet1.FieldByName('CuotasAdeudadas').AsString);
      grilla2.Cells[5,t]:=AnsiReplaceStr(trim(DataSet1.FieldByName('ImporteDeuda').AsString),',','.');
      grilla2.Cells[6,t]:=AnsiReplaceStr(trim(DataSet1.FieldByName('ImportePagare').AsString),',','.');
      tot:=tot + DataSet1.FieldByName('ImporteDeuda').AsFloat;
      tot1:=tot1 + DataSet1.FieldByName('ImportePagare').AsFloat;
    end;
    L9.Text:=inttostr(DataSet1.RecordCount);
    L8.Text:=floattostr(tot);
    L10.Text:=floattostr(tot * 0.3);
    L11.Text:=floattostr(tot1);
    ST1.Lines.Clear;
    if tot > 2500 then begin
      Agrega.Enabled:=true;
      ST1.Visible:=false;
      //ST1.Scroll:=false;
    end
    else begin
      ST1.Lines.Append(' EL IMPORTE');
      ST1.Lines.Append(' NO ALCANZA');
      ST1.Lines.Append(' PARA PAGARE');
      ST1.Visible:=true;
      //ST1.Scroll:=true;
    end;
  end
  else messagedlg('Sin Planes Activos para Pagaré',mtWarning,[mbok],0);
  DataSet1.Close;
  FreeAndNil(DataSet1);
end;
end;

