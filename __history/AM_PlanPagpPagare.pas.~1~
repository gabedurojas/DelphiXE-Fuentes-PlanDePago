Procedure TAM_Pagares.ImprimirPagare;
var ReporteRst: TfrxReport;
    t,y:integer;
    dmi:widestring;
    tmp:string;
begin
try
  ReporteRst:=TfrxReport.Create(nil);
  ReporteRst.LoadFromFile(Modulo2.Sistema.Path_todo + '\Reportes\PagarePP.fr3');
  TfrxPictureView(ReporteRst.FindObject('Logo1')).Picture.LoadFromFile(Modulo2.Sistema.Path_todo + '\Imagenes\LogoM2.jpg');
  TfrxPictureView(ReporteRst.FindObject('Logo2')).Picture.LoadFromFile(Modulo2.Sistema.Path_todo + '\Imagenes\LogoM2.jpg');
  TfrxPictureView(ReporteRst.FindObject('Logo3')).Picture.LoadFromFile(Modulo2.Sistema.Path_todo + '\Imagenes\LogoM2.jpg');
  TfrxPictureView(ReporteRst.FindObject('Logo4')).Picture.LoadFromFile(Modulo2.Sistema.Path_todo + '\Imagenes\LogoM2.jpg');

  ReporteRst.Variables['NroPagare'] := QuotedStr(NROPAG.Text);
  ReporteRst.Variables['Importe'] := QuotedStr(AnsiReplaceStr(trim(L11.Text),',','.'));
  tmp:=numtopesos(trim(L11.Text));
  ReporteRst.Variables['ImporteTxt'] := QuotedStr(tmp);
  ReporteRst.Variables['Fecha'] := QuotedStr(trim(FECHA.Text));
  ReporteRst.Variables['NroUsuario'] := QuotedStr(Modulo2.Usuario.UsuNro);
  ReporteRst.ShowReport;

except
  on E: Exception do EnviarLog(Self.Caption, 'Error en Reporte ' + E.Message);
end;
FreeAndNil(ReporteRst);
end;

Procedure TAM_Pagares.ImprimirResumen;
var ReporteRst: TfrxReport;
    frxDB1: TfrxDBDataset;
    DtsGrilla2:TClientDataSet;
    t,y:integer;
    dmi:string;
begin
try
{  grilla2.Cells[0,0]:='Ord';                 grilla2.Cells[1,0]:='N° Plan';
  grilla2.Cells[2,0]:='Fecha Creación';       grilla2.Cells[3,0]:='Cuotas Orig.';
  grilla2.Cells[4,0]:='Cuotas Adeudadas';     grilla2.Cells[5,0]:='Importe Deuda';
  grilla2.Cells[6,0]:='Importe Pagare';}
  //Cargamos la tabla de Objetos desde la grilla5
  DtsGrilla2:=TClientDataSet.Create(nil);
  DtsGrilla2.FieldDefs.Clear;
  DtsGrilla2.Active:=False;
  with DtsGrilla2.FieldDefs.AddFieldDef do begin
    Name:='Orden';DataType:=ftString;Size:=18;
  end;
  with DtsGrilla2.FieldDefs.AddFieldDef do begin
    Name:='NroPlan';DataType:=ftString;Size:=18;
  end;
  with DtsGrilla2.FieldDefs.AddFieldDef do begin
    Name:='Fecha';DataType:=ftString;Size:=18;
  end;
  with DtsGrilla2.FieldDefs.AddFieldDef do begin
    Name:='CuotasOri';DataType:=ftString;Size:=18;
  end;
  with DtsGrilla2.FieldDefs.AddFieldDef do begin
    Name:='CuotasDeu';DataType:=ftString;Size:=18;
  end;
  with DtsGrilla2.FieldDefs.AddFieldDef do begin
    Name:='ImpDeuda';DataType:=ftString;Size:=18;
  end;
  with DtsGrilla2.FieldDefs.AddFieldDef do begin
    Name:='ImpPagare';DataType:=ftString;Size:=18;
  end;
  DtsGrilla2.CreateDataSet;
  DtsGrilla2.Active:=True;
  y:=1;
  for t:=1 to Grilla2.RowCount-1 do begin
    DtsGrilla2.Append;
    DtsGrilla2.FieldValues['Orden']:=grilla2.Cells[0,t];
    DtsGrilla2.FieldValues['NroPlan']:=grilla2.Cells[1,t];
    DtsGrilla2.FieldValues['Fecha']:=grilla2.Cells[2,t];
    DtsGrilla2.FieldValues['CuotasOri']:=grilla2.Cells[3,t];
    DtsGrilla2.FieldValues['CuotasDeu']:=grilla2.Cells[4,t];
    DtsGrilla2.FieldValues['ImpDeuda']:=grilla2.Cells[5,t];
    DtsGrilla2.FieldValues['ImpPagare']:=grilla2.Cells[6,t];
    DtsGrilla2.Post;
  end;
  DtsGrilla2.SaveToFile(Modulo2.Sistema.Path_todo + '\Tmp\DtsGrilla2.xml',dfXML);
except
  on E: Exception do EnviarLog(Self.Caption, E.Message);
end;

//Imprimiendo
try
  ReporteRst:=TfrxReport.Create(nil);
  frxDB1:=TfrxDBDataset.Create(nil);
  frxDB1.DataSet:=DtsGrilla2;
  frxDB1.UserName:='frxDBDataset1';
  ReporteRst.DataSets.Add(frxDB1);
  ReporteRst.LoadFromFile(Modulo2.Sistema.Path_todo + '\Reportes\ResuPagarePP.fr3');
  TfrxPictureView(ReporteRst.FindObject('Logo1')).Picture.LoadFromFile(Modulo2.Sistema.Path_todo + '\Imagenes\LogoM2.jpg');

  ReporteRst.Variables['NroPagare'] := QuotedStr(NROPAG.Text);
  ReporteRst.Variables['Importe'] := QuotedStr(AnsiReplaceStr(trim(L11.Text),',','.'));
  ReporteRst.Variables['Fecha'] := QuotedStr(trim(FECHA.Text));
  ReporteRst.Variables['NomTitular'] := QuotedStr(CONTRIB.Text);
  ReporteRst.Variables['CuimTitular'] := QuotedStr(CUIM1.Text);
  ReporteRst.Variables['NroUsuario'] := QuotedStr(Modulo2.Usuario.UsuNro);
  ReporteRst.ShowReport;

except
  on E: Exception do EnviarLog(Self.Caption, 'Error en Reporte ' + E.Message);
end;
FreeAndNil(frxDB1);
FreeAndNil(ReporteRst);
FreeAndNil(DtsGrilla2);
end;
end.
