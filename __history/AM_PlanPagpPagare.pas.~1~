procedure TAM_Pagares.AgregaClick(Sender: TObject);
var gf,t:integer;
    id:string;
    comando:widestring;
    Com1:TADOCommand;
begin
gf:=messagedlg('Desea Guardar los Datos del Pagaré?' ,mtWarning,[mbok,mbCancel],0);
if gf = 1 then begin
  id:='0';
  try
    if strtoint(trim(NROPAG.Text)) <> 0 then id:=trim(NROPAG.Text);
  except
  end;
  try
    Com1:=TADOCommand.Create(nil);
    Com1.ConnectionString:=modulo2.Sistema.ConectDb;

    DataSet1:=TADODataSet.Create(nil);
    if id = '0' then begin
      DataSet1.ConnectionString:=modulo2.Sistema.ConectUsu;
      comando:='darmaximonro ' + chr(39) + 'PAGARES' + chr(39);
      DataSet1.CommandText:=comando;
      DataSet1.Open;
      id:=trim(DataSet1.Fields[0].AsString);
      NROPAG.Text:=completa1(id,8,'0');
      NROPAG.Enabled:=false;
      DataSet1.Close;
    end;

    comando:='EXEC SPA_PlanPagoPagare '
    + Id + ' , '
    + chr(39) + trim(FECHA.Text) + chr(39) + ' , '
    + chr(39) + trim(CUIM1.Text) + chr(39) + ' , '
    + chr(39) + AnsiReplaceStr(trim(CONTRIB.Text),chr(39),chr(33)) + chr(39) + ' , '
    + AnsiReplaceStr(trim(L11.Text),',','.') + ' , '
    + AnsiReplaceStr(trim(L8.Text),',','.') + ' , '
    + chr(39) + AnsiReplaceStr(trim(OBSERV.Text),chr(39),chr(33)) + chr(39) + ' , '
    + modulo2.Usuario.UsuNro + ' , '
    + chr(39) + modulo2.Sistema.MyHost + chr(39) + ' , '
    + chr(39) + modulo2.Sistema.MyIP + chr(39);

    DataSet1.ConnectionString:=modulo2.Sistema.ConectDb;
    DataSet1.CommandText:=comando;
    DataSet1.Open;
    id:=DataSet1.Fields[0].AsString;
    DataSet1.Close;

    {grilla2.Cells[0,0]:='Ord';                      grilla2.Cells[1,0]:='N° Plan';
    grilla2.Cells[2,0]:='Fecha Creación';            grilla2.Cells[3,0]:='Cuotas Orig.';
    grilla2.Cells[4,0]:='Cuotas Adeudadas';          grilla2.Cells[5,0]:='Importe Deuda';
    grilla2.Cells[6,0]:='Importe Pagare';       }
    for t:=1 to grilla2.RowCount-1 do begin
      comando:='EXEC SPA_PlanPagoPagarePlan '
      + id + ' , '
      + grilla2.Cells[1,t] + ' , '  //nroplan
      + grilla2.Cells[3,t] + ' , '  // cant cuotas
      + grilla2.Cells[6,t] + ' , '  // importe pagare
      + modulo2.Usuario.UsuNro + ' , '
      + chr(39) + modulo2.Sistema.MyHost + chr(39) + ' , '
      + chr(39) + modulo2.Sistema.MyIP + chr(39);
      Com1.CommandText:=comando;
      Com1.Execute;
    end;

    Imprime.Enabled:=true;
    Agrega.Enabled:=false;
    messagedlg('Pagare Guardado Correctamente' ,mtConfirmation,[mbok],0);
  except
    EnviarLog(self.Caption,comando);
    messagedlg('ERROR al Guardar los datos',mterror,[mbok],0);
  end;
  FreeAndNil(Com1);
  FreeAndNil(DataSet1);
end;
end;

