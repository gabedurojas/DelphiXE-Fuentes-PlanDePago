procedure TIntima_Busca.Edit2Change(Sender: TObject);
var t,p,u:integer;
    Cnx2:TADOConnection;
begin
 Cnx2:=TADOConnection.Create(nil);
 Cnx2.LoginPrompt:=false;
 Cnx2.ConnectionString:=Modulo2.Sistema.ConectInti;
 if (length(trim(edit2.Text))>= 10) then begin
  ELFILTRO.Close;
  ELFILTRO.CommandTimeout:=0;
  ELFILTRO.Connection:=Cnx2;
  ELFILTRO.CommandText:='SELECT Id,Contribuyente,TotalDeuda,case when NroDni IS null then 0 else NroDni end as NroDni,'
  + ' Barrio,Calle,case when Altura IS null then 0 else Altura end as Altura,Depto,Manzana,Casa,Torre,Domicilio,conanioaprescribir  '
  + ' FROM Fn_DeudaIntimacionContribuyentes (1) where Contribuyente like ' + QuotedStr(trim(edit2.Text) + chr(37)) ;
  ELFILTRO.Open;
  if ELFILTRO.IsEmpty then begin
   messagedlg('Conulta sin Resultados...' + chr(13) + 'Por favor realice otra Busqueda..',mtWarning,[mbok,mbCancel],0);
   for p:=0 to grilla3.ColCount-1 do
    for u:=1 to grilla3.RowCount-1 do grilla3.Cells[p,u]:='';
    grilla3.RowCount:=2;
   edit2.SetFocus;
  end
  else begin
   selec.Enabled :=true;
   for t:=1 to ELFILTRO.RecordCount do begin
    ELFILTRO.RecNo:=t;
    grilla3.RowCount:=t + 1;
    grilla3.Cells[1,t]:=ELFILTRO.FieldByName('Id').AsString;
    grilla3.Cells[2,t]:=ELFILTRO.FieldByName('Contribuyente').AsString;
    grilla3.Cells[3,t]:=ELFILTRO.FieldByName('TotalDeuda').AsString;
    grilla3.Cells[4,t]:=ELFILTRO.FieldByName('NroDni').AsString;
    grilla3.Cells[5,t]:=ELFILTRO.FieldByName('Barrio').AsString;
    grilla3.Cells[6,t]:=ELFILTRO.FieldByName('Calle').AsString;
    grilla3.Cells[7,t]:=ELFILTRO.FieldByName('Altura').AsString;
    grilla3.Cells[8,t]:=ELFILTRO.FieldByName('Depto').AsString;
    grilla3.Cells[9,t]:=ELFILTRO.FieldByName('Manzana').AsString;
    grilla3.Cells[10,t]:=ELFILTRO.FieldByName('Casa').AsString;
    grilla3.Cells[11,t]:=ELFILTRO.FieldByName('Torre').AsString;
    grilla3.Cells[12,t]:=ELFILTRO.FieldByName('Domicilio').AsString;
    grilla3.Cells[13,t]:=ELFILTRO.FieldByName('conanioaprescribir').AsString;
   end;
  end;
 end;
end;

procedure TIntima_Busca.Edit2KeyPress(Sender: TObject; var Key: Char);
