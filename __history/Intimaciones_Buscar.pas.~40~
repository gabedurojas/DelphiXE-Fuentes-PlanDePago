end;

procedure TIntima_Busca.Edit4Exit(Sender: TObject);
var t,u:integer;
begin
 t:=0;
 u:=0;
 if (cb2.Checked) and (trim(edit3.Text)<> '') then begin
  if (trim(Edit4.Text) = '') or (trim(Edit4.Text) = '0') then begin
    filtrar.SetFocus;
  end
  else begin
   try
    t:=strtoint(edit3.Text);
    u:=strtoint(edit4.Text);
   except
    edit3.Text:='0';
    edit4.Text:='0';
   end;
   if t > u then begin
    messagedlg('ERROR VALOR Desde no puede ser mayor a Desde!!!',mterror,[mbok],0);
    Edit4.SetFocus;
   end;
  end;
 end;
end;

procedure TIntima_Busca.Edit4KeyPress(Sender: TObject; var Key: Char);
