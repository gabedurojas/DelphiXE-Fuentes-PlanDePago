procedure TIntima_Busca.ContarSeleccionados(nro:byte);
var j,a:integer;
begin
fila2:=0;
 if nro= 1 then begin
  for j:=1 to grilla1.RowCount-1 do begin
   if trim(grilla1.Cells[1,j])<> '' then begin
    fila:=fila+1;
    break;
   end;
  end;
 end;
 if nro= 2 then begin
  for a:=1 to grilla3.RowCount-1 do begin
   if trim(grilla3.Cells[0,a]) <> '' then begin
