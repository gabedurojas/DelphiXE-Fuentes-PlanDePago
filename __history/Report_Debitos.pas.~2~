  VerArea(1);
  gh:=true;
  PC1.ActivePage:=PC1.Pages[0];
  ODNI.SetFocus;
end;
end;

procedure TConsul_Debitos.VerArea(nro:byte);
begin
DataSet.ConnectionString:=modulo2.Sistema.ConectUsu;
  if nro=1 then begin
    DataSet.CommandText:='SELECT nivel FROM usumodulos WHERE (modulo = 151) AND (codusu = ' + modulo2.Usuario.UsuNro + ');';
    DataSet.Open;
    dato:=DataSet.Fields[0].AsString;
    DataSet.Close;
  end;
end;

procedure TConsul_Debitos.grillactabancosDrawCell(Sender: TObject; ACol,
  ARow: Integer; Rect: TRect; State: TGridDrawState);
begin
   With Sender as TStringGrid do begin
     if (trim(grillactabancos.Cells[1,Arow]) = '---> DEBITO DE BAJA')
      or (trim(grillactabancos.Cells[1,Arow])='CTA. BANCARIA DE BAJA' ) then begin
       Canvas.Brush.Color := clYellow;
       Canvas.TextRect( Rect, Rect.Left+2, Rect.Top+2, Cells[acol, arow]);
     end;
   end;
end;

procedure  TConsul_Debitos.ImprimeConfirmacion();
var ReporteRst: TfrxReport;
    frxDB1,frxDB2: TfrxDBDataset;
    DtsObjetos, DtsGrilla2:TClientDataSet;
    t,y:integer;
begin
 try
    DtsObjetos:=TClientDataSet.Create(nil);
    DtsObjetos.FieldDefs.Clear;
    DtsObjetos.Active:=False;
    with DtsObjetos.FieldDefs.AddFieldDef do begin
      Name:='Orden';
      DataType:=ftInteger;
    end;
    with DtsObjetos.FieldDefs.AddFieldDef do begin
      Name:='Impuesto';
      DataType:=ftString;Size:=50;
    end;
    with DtsObjetos.FieldDefs.AddFieldDef do begin
      Name:='Objeto';
      DataType:=ftString;Size:=250;
    end;
    with DtsObjetos.FieldDefs.AddFieldDef do begin
      Name:='Detalle';
      DataType:=ftString;Size:=50;
    end;
    with DtsObjetos.FieldDefs.AddFieldDef do begin
      Name:='TipoCta';
      DataType:=ftString;Size:=50;
    end;
    with DtsObjetos.FieldDefs.AddFieldDef do begin
      Name:='NroCta';
      DataType:=ftString;Size:=150;
    end;
    with DtsObjetos.FieldDefs.AddFieldDef do begin
      Name:='Credito';
      DataType:=ftString;Size:=35;
    end;
    DtsObjetos.CreateDataSet;
    DtsObjetos.Active:=True;
    y:=1;
     for t:=1 to grillactabancos.RowCount-1 do begin
        DtsObjetos.Append;
        DtsObjetos.FieldValues['Orden']:=y;
        DtsObjetos.FieldValues['Impuesto']:=grillactabancos.Cells[0,t];
        DtsObjetos.FieldValues['Objeto']:=grillactabancos.Cells[1,t];
        DtsObjetos.FieldValues['Detalle']:=grillactabancos.Cells[2,t];
        DtsObjetos.FieldValues['TipoCta']:=grillactabancos.Cells[3,t];
        DtsObjetos.FieldValues['NroCta']:=grillactabancos.Cells[4,t];
        DtsObjetos.FieldValues['Credito']:='';//grillactabancos.Cells[5,t];
        DtsObjetos.Post;
        y:=y+1;
      end;
  except
    on E: Exception do EnviarLog(Self.Caption, E.Message);
  end;

//Imprimiendo
try
  ReporteRst:=TfrxReport.Create(nil);
  frxDB1:=TfrxDBDataset.Create(nil);
  frxDB1.DataSet:=DtsObjetos;
  frxDB1.UserName:='frxDBDataset1';
  ReporteRst.DataSets.Add(frxDB1);
  ReporteRst.LoadFromFile(Modulo2.Sistema.Path_todo + '\Reportes\Consulta_Debitos.fr3');
  TfrxPictureView(ReporteRst.FindObject('Logo1')).Picture.LoadFromFile(Modulo2.Sistema.Path_todo + '\Imagenes\LogoM2.jpg');
  TfrxPictureView(ReporteRst.FindObject('Logo2')).Picture.LoadFromFile(Modulo2.Sistema.Path_todo + '\Imagenes\logoformosa.jpg');
  ReporteRst.Variables['ElqueSuscribe'] := QuotedStr(elcontrib);
  ReporteRst.Variables['NroDni'] := QuotedStr(eldni);
  ReporteRst.Variables['NomTitular'] := QuotedStr(elcuit);
  ReporteRst.Variables['LugarFecha'] := QuotedStr('FORMOSA, ' + FechaToStr(FechaAct,'DDMMAAAA'));
  ReporteRst.Variables['NroUsuario'] := QuotedStr(Modulo2.Usuario.UsuNro);
  ReporteRst.ShowReport;
except
  on E: Exception do EnviarLog(Self.Caption, 'Error en Reporte ' + E.Message);
end;
FreeAndNil(frxDB1);
FreeAndNil(ReporteRst);
FreeAndNil(DtsObjetos);
end;

