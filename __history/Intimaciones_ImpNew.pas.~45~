function TIntima_ImpNew.VerificaGrillaDeuda(grilla:string):boolean;
var j,a:integer;
begin
 selecfila:=0;
 Result:=true;
 for j:=1 to grilla2.RowCount-1 do begin
  if trim(grilla2.Cells[1,j])='X' then begin
