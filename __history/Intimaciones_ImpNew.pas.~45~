procedure TIntima_ImpNew.modifdomClick(Sender: TObject);
var gf:integer;
    txt1:widestring;
    Cnx2:TADOConnection;
begin
 gf:=messagedlg('Confirma MODIFICAR el Domicilio del Contribuyente de esta Intimacion?',mtWarning,[mbok,mbCancel],0);
 if gf = 1 then begin
  Com1:=TADOCommand.Create(nil);
  Com1.ConnectionString:=Modulo2.Sistema.ConectInti;
  try
    Com1.CommandText:='SPM_IntimacionContribuyenteDomicilios '  + elcontrib
    + ' , ' + chr(39) + trim(d3.text) + chr(39)
    + ' , ' + chr(39) + trim(d4.text) + chr(39)
    + ' , ' + trim(d6.text)
    + ' , ' + chr(39) + trim(d8.text) + chr(39)
    + ' , ' + chr(39) + trim(d9.text) + chr(39)
    + ' , ' + chr(39) + trim(d11.text)+ chr(39)
    + ' , ' + chr(39) + trim(d13.text)+ chr(39)
    + ' , ' + chr(39) + trim(domi.text)+ chr(39) ;
    Com1.Execute;

    messagedlg('Domicilio Modificado Correctamente!!',mtConfirmation,[mbok],0);

    Com1.CommandText:='SPA_IntimacionContribuyenteDomiciliosModif '  + elcontrib
    + ' , ' + TComboClase(Origen.Items.Objects[Origen.ItemIndex]).Param1
    + ' , ' + modulo2.Usuario.UsuNro;
    Com1.Execute;

    PANEL1.Visible:=FALSE;
    coloca1(2,DataSet3.Fields[0].AsString);
  except
    on E: Exception do begin
     messagedlg('ERROR al Modificar los Datos del Domicilio',mtError,[mbok],0);
     EnviarLog(Self.Caption, E.Message);
     EnviarLog(Self.Caption, Com1.CommandText);
    end;
  end;
  FreeAndNil(Com1);
 end;
end;

