procedure TAlta_PlanPago.VerArea(nro:byte);
var t,b:integer;
    Cnx2:TADOConnection;
begin
 Cnx2:=TADOConnection.Create(nil);
 Cnx2.LoginPrompt:=false;
 Cnx2.ConnectionString:=Modulo2.Sistema.ConectDb;   // plan de pago
 if nro=1 then begin
  DataSet2.Close;
  DataSet2.Connection:=Cnx2;
  DataSet2.CommandText:='SELECT NroUsuario as Nrousuario FROM Fn_PlanPagoUsuariosAdmin (' + modulo2.Usuario.UsuNro + ')';
  DataSet2.Open;
  if not Dataset2.IsEmpty  then dato:=DataSet2.Fields[0].AsString
   else dato:='0';
  DataSet2.Connection:=nil;
 end;
 if nro=2 then begin
  idcintrib:='';
  DateSetTHBloq.Close;
  DateSetTHBloq.Connection:=Cnx2;
  DateSetTHBloq.CommandText:='SELECT IdContribuyente,TittularTH FROM THExcluirDeMoratoria '
  +' where (IdContribuyente =' + trim(idcont.Text) + ') and (activo=1)';
  DateSetTHBloq.Open;
  if not DateSetTHBloq.IsEmpty  then begin
   idcintrib:=DateSetTHBloq.Fields[0].AsString;
   titcontrib:=DateSetTHBloq.Fields[1].AsString;
   arbol.Enabled :=false;
  end
  else arbol.Enabled :=true;
  DateSetTHBloq.Connection:=nil;
 end;
 if nro=3 then begin
  DataSet3.Close;
  DataSet3.Connection:=Cnx2;
  DataSet3.CommandText:='SELECT [FechaCorte] FROM [PlanesPagos].[dbo].[PlanPagoConfig] where FechaBaja is null';
  DataSet3.Open;
  if not DataSet3.IsEmpty  then begin
   diacorte:=DataSet3.Fields[0].AsString;
  end;
  DataSet3.Connection:=nil;
 end;
 if nro=4 then begin  /// verifico usuario para hacer el 10% de descuento a la deuda
  DataSet2.Close;
  DataSet2.Connection:=Cnx2;
  DataSet2.CommandText:='SELECT NroUsuario as Nrousuario FROM [PlanesPagos].[dbo].Fn_AplicaDescuentoPP (' + modulo2.Usuario.UsuNro + ')';
  DataSet2.Open;
  if not Dataset2.IsEmpty  then CheckBoxDto.Visible:=true     //usudto:=DataSet2.Fields[0].AsString
   else CheckBoxDto.Visible:=false; //usudto:='0';
  DataSet2.Connection:=nil;
 end;
 Cnx2.Close;
 FreeAndNil(Cnx2);
end;

procedure TAlta_PlanPago.OrdenaGrilla(Grid: TStringGrid; Col: integer);
var i, j: integer;
prev: string;
begin
//in worst-case scenario we'll need RowCount-1 iterations to fully sort the grid
 for j:= 0 to Grid.RowCount- 1 do
 for i:= 2 to Grid.RowCount- 1 do  begin
  if strtoint(Grid.Cells[Col, i])> strtoint(Grid.Cells[Col, i-1]) then begin // < if you want to reverse the sort order
   prev:= Grid.Rows[i- 1].CommaText;
   Grid.Rows[i- 1].CommaText:= Grid.Rows[i].CommaText;
   Grid.Rows[i].CommaText:= prev;
  end;
 end;
end;

