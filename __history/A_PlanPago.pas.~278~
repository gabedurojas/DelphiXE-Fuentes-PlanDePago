  PC1.ActivePage:=PC1.Pages[0];
  PB2.Position:=0;
  PG1.Position:=0;
  pc1.Pages[1].TabVisible:=false;
 end;
 if nro=2 then begin
  ColocaCombo(1);                  ColocaCombo(2);
  ColocaCombo(3);                 //   ColocaCombo(8);
  CUIM.Clear;                      contribid.Clear;
  CONTRIB.Clear;                   ALTURA1.Text:='0';
