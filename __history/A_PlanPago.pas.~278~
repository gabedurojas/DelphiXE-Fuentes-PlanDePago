  MANZANA1.Clear;                  CASA1.Clear;
  TORRE1.Clear;                    SECTOR1.Clear;
  PARCELA1.Clear;                  LOTERURAL1.Clear;
  TELEFONO.Clear;                  DOMI1.Clear;
