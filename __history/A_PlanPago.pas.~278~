  imp:='07';
  Recibo.SubRubro:='1110408';
  Recibo.Importe1:=FormatFloat('000000.00',StrToFloat(AnsiReplaceStr(trim(VALSELLADO.Text),',','.')));
  Recibo.Importe2:=FormatFloat('000000.00',StrToFloat(AnsiReplaceStr(trim(VALSELLADO.Text),',','.')));
  Recibo.NroCobro:=modulo2.Sistema.PuntoV + RightStr(VENC1.Text,2) + ' - ' + imp + '90';
  dmi:='927' + StrFill(AnsiReplaceStr(trim(VALSELLADO.Text),'.',''),8,'0','');
  tmp:=FechaAct;
  if strtodate(trim(VENC1.Text)) >  strtodate(FechaAct) then tmp:=trim(VENC1.Text);
  dmi:=dmi + RightStr(tmp,2);
  dmi:=dmi + StrFill(fecha_dif('01/01/' +  RightStr(tmp,4),FechaAct),3,'0','');
  dmi:=dmi + StrFill(modulo2.Sistema.PuntoV,2,'0','') + RightStr(tmp,2);
  dmi:=dmi + imp + '00';
  dmi:=dmi + Recibo.NroLiquidacion + '0';
  dmi:=dmi + StrFill(AnsiReplaceStr(trim(VALSELLADO.Text),'.',''),8,'0','');
  dmi:=dmi + RightStr(tmp,2);
  dmi:=dmi + StrFill(fecha_dif('01/01/' +  RightStr(tmp,4),FechaAct),3,'0','');
  dmi:=dmi + digitos(dmi, 1);
  Recibo.NroCodBar:=dmi;
 end;

 try
  Com1:=TADOCommand.Create(nil);
  Com1.Connection:=Cnx2;
  DataSet3.CommandText:='EXEC SPA_tasaanualLiquidacion ' + chr(39) + Recibo.CuimTit + chr(39)
