  + ' , NULL, NULL, ' + MidStr(Recibo.CuimTit,4,8)
  + ' , ' + chr(39) + LeftStr(Recibo.NombreTit,50) + chr(39)
  + ' , NULL, ' + Recibo.Importe1
  + ' , ' + chr(39) + FechaAct + chr(39)
  + ' , ' + Recibo.Importe1
  + ' , ' + chr(39) + FechaAct + chr(39)
  + ' , ' + RightStr(tmp,4)
  + ' , ' + imp + '90 ,' + Recibo.NroLiquidacion
  + ' , ' + chr(39) + Recibo.NroCodBar + chr(39)
  + ' , ' + Modulo2.Sistema.PuntoV
  + ' , ' + Modulo2.Usuario.UsuNro
  + ' , ' + LeftStr(Recibo.SubRubro,5) + ' ,NULL, NULL, 1, 1, 0, 0, ' + Recibo.SubRubro;
  DataSet3.Open;
  Recibo.IdRegistro:=DataSet3.Fields[0].AsString;
  DataSet3.Close;
  DataSet3.Connection:=nil;

  {ej: el periodo es 0110 que significa cuota 01 de 10}
  if strtoint(cuotas.Text) = 1 then begin
   Com1.CommandText:='EXEC SPA_TasaAnualLiquidacionCuotas ' + Recibo.IdRegistro
   + ' , ' + RightStr(tmp,4) + ', 1, ' + '01' + StrFill(trim(CUOTAS.Text),2,'0','')
   + ' , ' + Recibo.NroLiquidacion
   + ' , ' + modulo2.Sistema.PuntoV
   + ' , ' + 'NULL , ' + Recibo.Importe1
   + ' , ' + '0, ' + Recibo.Importe1 + ' , 0, 0, 0, ' + Recibo.SubRubro;
  end
  else begin
   Com1.CommandText:='EXEC SPA_TasaAnualLiquidacionCuotas ' + Recibo.IdRegistro
   + ' , ' + RightStr(tmp,4) + ', 0, ' + '010'
   + ' , ' + Recibo.NroLiquidacion
   + ' , ' + modulo2.Sistema.PuntoV
   + ' , ' + 'NULL , ' + Recibo.Importe1
   + ' , ' + '0, ' + Recibo.Importe1 + ' , 0, 0, 0, ' + Recibo.SubRubro;
  end;
  Com1.Execute;
 except
  on E: Exception do EnviarLog(Self.Caption, E.Message);
 end;
 Cnx2.Close;
 FreeAndNil(DataSet3);
 FreeAndNil(Com1);
 FreeAndNil(Cnx2);
