 y:=1;
 dmi:='';
 tmp:='';
 for t:=1 to ARBOL.Items.Count-1 do begin
  if (Arbol.ItemState[t] = csChecked) and (Objetos.EsContenedor.Strings[t] = '0') then begin
   tmp:=Objetos.Rubro.Strings[t];
   break;
