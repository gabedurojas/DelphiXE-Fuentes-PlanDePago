procedure TAlta_PlanPago.CalcularDescuento;
var b,t,y:integer;
    valor1,valor2,valor3,valor4,valor5,Desc,Cap,IntDev,IntRem:real;
    DataSet2:TADODataSet;
    Comando:widestring;
    tx:string;
    Cnx2:TADOConnection;
begin
 Cap:=0;
 IntDev:=0;
 IntRem:=0;
 CAPITAL.Text:='0.00';         INTERESDEV.Text:='0.00';
 INTERESREM.Text:='0.00';      SUBTOTAL.Text:='0.00';
 TOTAL.Text:='0.00';           TOTALINTERES.Text:='0.00';
 CONDPLAN.Enabled:=true;
 CONTRPLAN.Enabled:=true;
 FINPLAN.Enabled:=true;
 for b:=0 to grilla5.ColCount-1 do
   for t:=1 to grilla5.RowCount-1 do  grilla5.Cells[b,t]:='';
  grilla5.RowCount:=2;

 if trim(grilla2.Cells[0,1]) <> '' then begin
  if C1.Checked then tx:='1'
  else tx:='0';
  try
   Cnx2:=TADOConnection.Create(nil);
   Cnx2.LoginPrompt:=false;
   Cnx2.ConnectionString:=Modulo2.Sistema.ConectDb;   //plandepagos
   DataSet2:=TADODataSet.Create(nil);
   DataSet2.Connection:=Cnx2;
   Comando:='SPP_CalculaDescuentos ' + Modulo2.Usuario.UsuNro   //SPP_CalculaDescuentosv2
   + ' , ' + chr(39) + Modulo2.Sistema.MyIP + chr(39)
   + ' , ' + CUOTAS.Text
   + ' , ' + tx;
   DataSet2.CommandText:=Comando;
   DataSet2.Open;
   CAPITAL.Text:=DataSet2.FieldByName('Capital').AsString;
   INTERESDEV.Text:=DataSet2.FieldByName('InteresDev').AsString;
   SUBTOTAL.Text:=DataSet2.FieldByName('SubTotal').AsString;
   INTERESREM.Text:=DataSet2.FieldByName('InteresRem').AsString;
   TOTAL.Text:=DataSet2.FieldByName('Total').AsString;
   DataSet2.Close;
   Comando:='SELECT dbo.TmpPlanPagoObj.IdSubRubro, dbo.TmpPlanPagoObj.CodigoObjeto, dbo.TmpPlanPagoObj.Identificador, '
   + 'dbo.TmpPlanPagoPeriodo.Periodo,convert(char(10),dbo.TmpPlanPagoPeriodo.FechaVencimiento,103) as FechaVencimiento, dbo.TmpPlanPagoPeriodo.Capital, '
   + 'dbo.TmpPlanPagoPeriodo.Interes,dbo.TmpPlanPagoPeriodo.SubTotal,dbo.TmpPlanPagoPeriodo.CapitalRef, '
   + 'dbo.TmpPlanPagoPeriodo.InteresRef,dbo.TmpPlanPagoPeriodo.SubTotalRef,dbo.TmpPlanPagoPeriodo.PorcientoDescuento, '
   + 'dbo.TmpPlanPagoPeriodo.TotalDescuento,dbo.TmpPlanPagoPeriodo.TotalPeriodo,dbo.TmpPlanPagoPeriodo.EsMulta '
   + 'FROM dbo.TmpPlanPagoObj INNER JOIN dbo.TmpPlanPagoPeriodo ON dbo.TmpPlanPagoObj.Id = dbo.TmpPlanPagoPeriodo.IdObjeto '
   + 'WHERE (dbo.TmpPlanPagoObj.NroUsuario = ' + Modulo2.Usuario.UsuNro + ') AND (dbo.TmpPlanPagoObj.Ip = '
   + chr(39) + Modulo2.Sistema.MyIP + chr(39) + ')';
   DataSet2.CommandText:=Comando;
   DataSet2.Open;
   for y:=1 to DataSet2.RecordCount do begin
    DataSet2.RecNo:=y;
    grilla2.RowCount:=y+1;
    grilla2.Cells[0,y]:=DataSet2.FieldByName('IdSubRubro').AsString;
    grilla2.Cells[1,y]:=DataSet2.FieldByName('CodigoObjeto').AsString;
    grilla2.Cells[2,y]:=DataSet2.FieldByName('Periodo').AsString;
    grilla2.Cells[3,y]:=DataSet2.FieldByName('FechaVencimiento').AsString;
    grilla2.Cells[4,y]:=DataSet2.FieldByName('Capital').AsString;
    grilla2.Cells[5,y]:=DataSet2.FieldByName('Interes').AsString;
    grilla2.Cells[6,y]:=DataSet2.FieldByName('SubTotal').AsString;
    grilla2.Cells[7,y]:=DataSet2.FieldByName('CapitalRef').AsString;
    grilla2.Cells[8,y]:=DataSet2.FieldByName('InteresRef').AsString;
    grilla2.Cells[9,y]:=DataSet2.FieldByName('SubTotalRef').AsString;
    grilla2.Cells[10,y]:=DataSet2.FieldByName('PorcientoDescuento').AsString;
    grilla2.Cells[11,y]:=DataSet2.FieldByName('TotalDescuento').AsString;
    // grilla2.Cells[12,y]:=DataSet2.FieldByName('Total').AsString;
    grilla2.Cells[12,y]:=DataSet2.FieldByName('TotalPeriodo').AsString;
    grilla2.Cells[13,y]:=DataSet2.FieldByName('Identificador').AsString;
    grilla2.Cells[14,y]:=DataSet2.FieldByName('EsMulta').AsString;
   end;
   DataSet2.Close;
   DataSet2.Connection:=nil;
  except
    messagedlg('Error al calcular los descuentos',mterror,[mbok],0);
  end;
  FreeAndNil(DataSet2);
  Cnx2.Close;
  FreeAndNil(Cnx2);
 end
 else begin
  CONDPLAN.Enabled:=false;
  CONTRPLAN.Enabled:=false;
  FINPLAN.Enabled:=false;
 end;
end;

