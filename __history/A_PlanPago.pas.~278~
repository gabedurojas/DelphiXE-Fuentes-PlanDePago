procedure TAlta_PlanPago.Coloca1(nro:byte);
var t,y:integer;
    TotInt:real;
    Hijo,Nieto,Bisnieto:TTreeNode;
    DataSet3:TADODataSet;
    Cnx2:TADOConnection;
    tx:string;
    ps:boolean;
begin
 try
  if nro = 1 then begin
    Arbol.Items.Clear;
    Objetos.CantObjetos:=0;
    Objetos.Identidad.Clear;
    Objetos.EsContenedor.Clear;
    Objetos.Rubro.Clear;
    Objetos.ConDeuda.Clear;
    Objetos.CodObjeto.Clear;
    Objetos.Descripcion.Clear;
    Objetos.EsPlan.Clear;
    Objetos.ImportePagado.Clear;
    Objetos.DetalleImpu.Clear;
    Objetos.BajaProvisoria.Clear;

    Arbol.Items.Add(nil,'OBJETOS DEL CONTRIBUYENTE');
    Objetos.Identidad.Append('');
    Objetos.EsContenedor.Append('1');
    Objetos.Rubro.Append('');
    Objetos.ConDeuda.Add('');
    Objetos.CodObjeto.Append('');
    Objetos.Descripcion.Add('');
    Objetos.EsPlan.Add('');
    Objetos.ImportePagado.Add('');
    Objetos.DetalleImpu.Add('');
    Cnx2:=TADOConnection.Create(nil);
    Cnx2.LoginPrompt:=false;
    Cnx2.ConnectionString:=Modulo2.Sistema.ConectSeg; ///seguridadweb

    DataSet3:=TADODataSet.Create(nil);
    DataSet3.Connection:=Cnx2;
    ps:=false;
    Application.ProcessMessages;
    DataSet3.CommandTimeout:=120;
    DataSet3.CommandText:='SELECT Id, Texto, Identidad, EsContenedor, Rubro, Condeuda, '
    + 'CodObjeto, Descripcion, ImportePagado, Esplan, DetalleImpu, BajaProvisoria FROM Fn_ObjetosTree (' + IDCONT.Text + ' , 0)';
    DataSet3.Open;
    if not DataSet3.IsEmpty then begin
     for t:=1 to DataSet3.RecordCount do begin
      DataSet3.RecNo:=t;
      if DataSet3.FieldByName('EsContenedor').AsBoolean then begin
       Hijo:=Arbol.Items.AddChild(Arbol.Items[0],DataSet3.FieldByName('Texto').AsString);
       Objetos.EsContenedor.Append('1');
      end
      else begin
       if DataSet3.FieldByName('BajaProvisoria').AsBoolean then begin
        Arbol.Items.AddChild(Hijo,'C/ DENUNCIA DE VENTA -> ' + DataSet3.FieldByName('Texto').AsString);
        ps:=true;
       end
       else
        Arbol.Items.AddChild(Hijo,DataSet3.FieldByName('Texto').AsString);
        Objetos.EsContenedor.Append('0');
      end;
      Objetos.Identidad.Append(DataSet3.FieldByName('Identidad').AsString);
      Objetos.Rubro.Append(DataSet3.FieldByName('Rubro').AsString);  //El estado del plan
      Objetos.DetalleImpu.Add(DataSet3.FieldByName('DetalleImpu').AsString);
      if DataSet3.FieldByName('Esplan').AsBoolean then Objetos.EsPlan.Add('1')
       else Objetos.EsPlan.Add('0');
      Objetos.ConDeuda.Add(DataSet3.FieldByName('Condeuda').AsString);
      Objetos.ImportePagado.Add(DataSet3.FieldByName('ImportePagado').AsString);
      Objetos.CodObjeto.Append(DataSet3.FieldByName('CodObjeto').AsString);
      Objetos.Descripcion.Add(DataSet3.FieldByName('Descripcion').AsString);
     end;
    end;
    DataSet3.Close;
    DataSet3.Connection:=nil;
    FreeAndNil(DataSet3);
    Cnx2.Close;
    FreeAndNil(Cnx2);
    panel1.Visible:=false;
    if ps then messagedlg('ATENCION!!!... Tenga en cuenta que existe algùn AUTOMOTOR con DENUNCIA DE VENTA!!!',mtError,[mbok],0);
  end;
  if nro=2 then begin
   TotInt:=0;
   if trim(grilla5.Cells[0,1]) <> '' then begin
    for t:=1 to grilla5.RowCount-1 do begin
     TotInt:=TotInt + StrToFloat(grilla5.Cells[3,t]);
     totalinteres.Text:= floattostr(TotInt);
    end;
   end;
  end;
 except
  on E: Exception do begin
   EnviarLog(Self.Caption, E.Message);
   EnviarLog(Self.Caption, DataSet3.CommandText);
   EnviarLog(self.Caption,Objetos.Identidad.Strings[t] + ' - ' + Parametro);
  end
 end;
end;

