procedure TautosCasas_Buscar.grilla1Click(Sender: TObject);
var b,t,j:integer;
begin
 if grilla1.Cells[1,grilla1.Row] <> '' then begin
  if trim(grilla1.Cells[3,grilla1.Row]) = '' then begin
    messagedlg('Contribuyente sin Deuda a la Fecha',mtError,[mbok,mbCancel],0);
  end
  else begin
   if trim(grilla1.Cells[0,grilla1.Row])='' then begin
    grilla1.Cells[0,grilla1.Row]:='X';
    totalselec1:=totalselec1 + 1;
   end
   else begin
    grilla1.Cells[0,grilla1.Row]:='';
    totalselec1:=totalselec1 - 1;
   end;
   Dato:=grilla1.Cells[1,grilla1.Row];
   Coloca1(3,Dato);
   verificagrilladeuda('grilla1');
   Barra1.Panels[2].Text:='Cant. Registros Seleccionados: ' + inttostr(totalselec1);
  end;
 end;

 if totalselec1=0 then PopupMenu1.Items[5].Enabled:=false
  else PopupMenu1.Items[5].Enabled:=true;
 sumad:=0;
 for t:=1 to grilla1.RowCount-1 do begin
  if (grilla1.Cells[0,t] = 'X')  then begin
    sumad := sumad + strtofloat(grilla1.Cells[3,t]);
  end;
 end;
 PC1.ActivePage:=PC1.Pages[1];

 Barra1.Panels[3].Text:='Total Deuda Seleccionada: $' + floattostr(sumad);
end;

procedure TautosCasas_Buscar.guardaClick(Sender: TObject);
var t,y,a:integer;
    Com1:TADOCommand;
    comando:widestring;
    tx,idcont:string;
    Cnx2:TADOConnection;
begin
t:=messagedlg('Confirma guardar las Intimaciones seleccionada?',mtInformation,[mbok,mbCancel],0);
if t = 1 then begin
 if totalselec = 0 then begin
  messagedlg('            I M P O S I B L E   G U A R D A R' + chr(13)
  + 'Este Lote de Intimaciones, porque no existe ningun Contribuyente Seleccionado ',mtError,[mbok],0);
  if JvgGroupBox1.Visible then edit1.SetFocus;
 end
 else begin
  coloca1(4,'');
  SplashConNro := TSplashConNro.Create(Application);
  SplashConNro.Show;
  SplashConNro.ProgressBar1.Max:=grilla1.RowCount- 1;
  Cnx2:=TADOConnection.Create(nil);
  Cnx2.LoginPrompt:=false;
  Cnx2.ConnectionString:=Modulo2.Sistema.ConectInti;
  Com1:=TADOCommand.Create(nil);
  Com1.Connection:=Cnx2;
  try
   for t:=1 to grilla1.RowCount-1 do begin
    if (grilla1.Cells[0,t] = 'X') then begin
      DataSet1.Connection:=Cnx2;
      DataSet1.CommandText:='SPA_IntimacionContribuyente ' + grilla1.Cells[1,t]
      + ' , ' + chr(39) + grilla1.Cells[2,t] + chr(39)
      + ' , ' + grilla1.Cells[4,t]
      + ' , ' + chr(39) + grilla1.Cells[5,t] + chr(39)
      + ' , ' + chr(39) + grilla1.Cells[6,t] + chr(39)
      + ' , ' + grilla1.Cells[7,t]
      + ' , ' + chr(39) + grilla1.Cells[8,t] + chr(39)
      + ' , ' + chr(39) + grilla1.Cells[9,t] + chr(39)
      + ' , ' + chr(39) + grilla1.Cells[10,t] + chr(39)
      + ' , ' + chr(39) + grilla1.Cells[11,t] + chr(39)
      + ' , ' + chr(39) + grilla1.Cells[12,t] + chr(39)
      + ' , ' + chr(39) + grilla1.Cells[3,t] + chr(39)
      + ' , ' + chr(39) + FechaAct + chr(39)
      + ' , ' + modulo2.Usuario.UsuNro
      + ' , ' + Nrolote
      + ' , ' + chr(39) + FechaAct + chr(39)
      + ' , ' + modulo2.Usuario.UsuNro;
      DataSet1.Open;
      tx:=DataSet1.Fields[0].AsString;
      DataSet1.Close;
      DataSet1.Connection:=nil;

      LOSRUBROS.Close;
      LOSRUBROS.Connection:=Cnx2;
      LOSRUBROS.CommandText:='SELECT IdDeudaIntimacionContribuyente,DetalleImpu,CodigoObjeto,isnull(Capital,0) as Capital,'
      + 'isnull(Interes,0) as Interes,isnull(ImporteDeuda,0) as ImporteDeuda,'
      + 'PeriodoDeuda,Identificador,IdSubRubro FROM DeudaIntimacionObjetos WHERE (IdDeudaIntimacionContribuyente = '+ grilla1.Cells[1,t] +') order by 2';
      LOSRUBROS.Open;
      if LOSRUBROS.IsEmpty then begin
        messagedlg('Contribuyente Inexistente...' + chr(13) + 'Por favor realice otra Busqueda..',mtWarning,[mbok,mbCancel],0);
      end
      else begin
       for a:=1 to LOSRUBROS.RecordCount do begin
        LOSRUBROS.RecNo:=a;
        grilla2.RowCount:=a + 1;
        grilla2.Cells[0,a]:=LOSRUBROS.FieldByName('IdDeudaIntimacionContribuyente').AsString;
        grilla2.Cells[1,a]:=LOSRUBROS.FieldByName('DetalleImpu').AsString;
        grilla2.Cells[2,a]:=LOSRUBROS.FieldByName('CodigoObjeto').AsString;
        grilla2.Cells[3,a]:=LOSRUBROS.FieldByName('Capital').AsString;
        grilla2.Cells[4,a]:=LOSRUBROS.FieldByName('Interes').AsString;
        grilla2.Cells[5,a]:=LOSRUBROS.FieldByName('ImporteDeuda').AsString;
        grilla2.Cells[6,a]:=LOSRUBROS.FieldByName('PeriodoDeuda').AsString;
        grilla2.Cells[7,a]:=LOSRUBROS.FieldByName('Identificador').AsString;
        grilla2.Cells[8,a]:=LOSRUBROS.FieldByName('IdSubRubro').AsString;
       end;
       for y:=1 to grilla2.RowCount-1 do begin
        Com1.CommandText:='SPA_IntimacionContribuyenteObjeto ' + tx
        + ' , ' + chr(39) + trim(grilla2.Cells[1,y]) + chr(39)
        + ' , ' + chr(39) + trim(grilla2.Cells[2,y]) + chr(39)
        + ' , ' + trim(grilla2.Cells[3,y])
        + ' , ' + trim(grilla2.Cells[4,y])
        + ' , ' + trim(grilla2.Cells[5,y])
        + ' , ' + chr(39) + trim(grilla2.Cells[6,y]) + chr(39)
        + ' , ' + trim(grilla2.Cells[7,y])
        + ' , ' + trim(grilla2.Cells[8,y]);
        Com1.Execute;
       end;
       comando:='SPA_IntimacionContribuyenteEstado ' + tx + ' , 1 , 1 , '  + modulo2.Usuario.UsuNro + ' , null';
       Com1.CommandText:=comando;
       Com1.Execute;
       SplashConNro.ProgressBar1.Position:=t;
       SplashConNro.Label3.Caption:=inttostr(t);
       SplashConNro.Update;
      end;
      LOSRUBROS.Connection:=nil;
    end;
   end;
   messagedlg('Datos Guardado Correctamente!' + chr(13) + 'El Nro. de Lote generado es: ' + Nrolote,mtConfirmation,[mbok],0);
   limpia.Click;
  except
    messagedlg('ERROR al Guardar los Datos',mtError,[mbok],0);
  end;
  Cnx2.Close;
  FreeAndNil(Cnx2);
  SplashConNro.Hide;
  SplashConNro.Free;
 end;
end;
end;

