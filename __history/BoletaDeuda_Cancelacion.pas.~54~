function TBoletaDeuda_Cancelaciontotal.VerificaGrillaDeuda(grilla:string):boolean;
var j,a:integer;
begin
 selecfila:=0;
 Result:=true;
 for j:=1 to grilla1.RowCount-1 do begin
  if trim(grilla1.Cells[1,j])='X' then begin
   selecfila:=selecfila+1;
   Result:=false;
   break;
  end;
 end;
 if selecfila=0 then  confirma.Enabled :=false
  else confirma.Enabled :=true;
end;

procedure TBoletaDeuda_Cancelaciontotal.FormKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
 case key of
  VK_F4 : begin
    aceptar.Click;
  end;
  VK_F3 : begin
    filtrar.Click;
  end;
  VK_F7 : begin
   if selecfila> 0 then confirma.Click;
  end;
 end;
end;

