procedure TBoletaDeuda_Cancelaciontotal.grilla1Click(Sender: TObject);
var     Cnx2:TADOConnection;
        totr,t,b:integer;
begin

 Modulo2.ObjConexion:=TADOConnection.Create(nil);
 Modulo2.ObjConexion.LoginPrompt:=false;
 Modulo2.ObjConexion.ConnectionString:=modulo2.Sistema.ConectInti;

 if grilla1.Cells[0,grilla1.Row] <> '' then begin
  if trim(grilla1.Cells[1,grilla1.Row])='' then grilla1.Cells[1,grilla1.Row]:='X'
   else grilla1.Cells[1,grilla1.Row]:='';
  verificagrilladeuda('grilla1');
 end;

 totr:=0;
 for t:=1 to grilla1.RowCount-1 do begin
    if (grilla1.Cells[1,t]) = 'X' then begin
    totr:=totr + 1;
  end;
 end;

 // verifico que no seleccione mas de un registro
 if totr > 1 then begin
  messagedlg('ATENCION...' + chr(13) + 'Ud. a seleccionado mas de una Boleta de deuda..',mtInformation,[mbok,mbCancel],0);
  for b:=0 to grilla1.ColCount-1 do
   for t:=1 to grilla1.RowCount-1 do  grilla1.Cells[1,t]:='';
   verificagrilladeuda('grilla1');
   //FreeAndNil(LOSOBJETOS);
 end
 else begin
    if trim(grilla1.Cells[1,grilla1.Row]) <> '' then begin
     valor:='';
     valor:=trim(grilla1.Cells[16,grilla1.Row]);
     eldni:='';
     eldni:=trim(grilla1.Cells[4,grilla1.Row]);
     nroctrol:='';
     nroctrol:=trim(grilla1.Cells[17,grilla1.Row]);
      try
       Modulo2.ObjConexion:=TADOConnection.Create(nil);
       Modulo2.ObjConexion.LoginPrompt:=false;
       Modulo2.ObjConexion.ConnectionString:=modulo2.Sistema.ConectInti;
       LOSOBJETOS.Close;
       LOSOBJETOS.Connection:=modulo2.ObjConexion;
       LOSOBJETOS.CommandText:='SELECT dbo.IntimacionContribuyenteObjeto.IdIntimacionContribuyente,'
       +' municipio.dbo.RubrosSub.descripcion,dbo.IntimacionContribuyenteObjeto.CodigoObjeto,  dbo.IntimacionContribuyenteObjeto.Identificador , '
       +' dbo.IntimacionContribuyenteObjeto.Capital, dbo.IntimacionContribuyenteObjeto.Interes, dbo.IntimacionContribuyenteObjeto.ImporteDeuda, '
       +' dbo.IntimacionContribuyenteObjeto.PeriodoDeuda ,dbo.IntimacionContribuyenteObjeto.Id, '
       +' municipio.dbo.RubrosSub.idRubro,  municipio.dbo.RubrosSub.idSubRubro ,'
       +' (SELECT top 1 [Periodo] FROM [IntimacionesNew].[dbo].[IntimacionContribuyenteObjetoPeriodo] '
       +' where [IdIntimacionContribuyenteObjeto] =dbo.IntimacionContribuyenteObjeto.Id  order by id asc) as periododesde,'
       +' (SELECT top 1 [Periodo] FROM [IntimacionesNew].[dbo].[IntimacionContribuyenteObjetoPeriodo]'
       +' where [IdIntimacionContribuyenteObjeto] =dbo.IntimacionContribuyenteObjeto.Id  order by id desc) as periohasta '
       + 'FROM  municipio.dbo.RubrosSub '
       +' INNER JOIN dbo.IntimacionContribuyenteObjeto ON municipio.dbo.RubrosSub.idSubRubro = dbo.IntimacionContribuyenteObjeto.IdSubRubro'
       +' where dbo.IntimacionContribuyenteObjeto.IdIntimacionContribuyente = (' + valor + ')';
       LOSOBJETOS.Open;
       if LOSOBJETOS.IsEmpty then begin
        messagedlg('Objetos Inexistente...' + chr(13) + 'Por favor realice otra Busqueda..',mtWarning,[mbok,mbCancel],0);
        edit3.SetFocus;
       end
       else begin
        JvDBGrid2.Columns[0].Width:=60;
        JvDBGrid2.Columns[1].Width:=220;
        JvDBGrid2.Columns[2].Width:=90;
        JvDBGrid2.Columns[3].Width:=90;
        JvDBGrid2.Columns[4].Width:=90;
        JvDBGrid2.Columns[5].Width:=90;
        JvDBGrid2.Columns[6].Width:=100;
        JvDBGrid2.Columns[7].Width:=60;
        JvDBGrid2.Columns[8].Width:=60;
        JvDBGrid2.Columns[9].Width:=80;
        Barra1.Panels[1].Text:='Cant. Registros: ' + inttostr(CONTRIBUYENTE.RecordCount);
       end;
       LOSOBJETOS.Connection:=nil;
       FreeAndNil(Modulo2.ObjConexion);
      except
       on E: Exception do begin
         EnviarLog(Self.Caption, E.Message);
       end
      end;
