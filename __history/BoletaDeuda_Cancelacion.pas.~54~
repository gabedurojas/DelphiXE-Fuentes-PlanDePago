procedure TBoletaDeuda_Cancelaciontotal.AceptarClick(Sender: TObject);
var t,y,gf,p,u:integer;
    Com1:TADOCommand;
    ellote,elnroboleta:string;
    Cnx2:TADOConnection;
begin
t:=messagedlg('Confirma el Cambio de Estados para esta Boleta de Deuda seleccionada?',mtWarning,[mbok,mbCancel],0);
 if t = 1 then begin
  if selecfila = 0 then begin
   messagedlg('            I M P O S I B L E   C O N F I R M A R ' + chr(13)
   + 'porque no existe ninguna Boleta de Deuda Seleccionada ',mtError,[mbok],0);
   panel11.Visible:=false;
   grilla1.SetFocus;
  end
  else begin
   Cnx2:=TADOConnection.Create(nil);
   Cnx2.LoginPrompt:=false;
   Cnx2.ConnectionString:=Modulo2.Sistema.ConectInti;
   Com1:=TADOCommand.Create(nil);
   Com1.Connection:=Cnx2;
   for gf:=1 to grilla1.RowCount-1 do begin
    if (grilla1.Cells[1,gf] = 'X') and (grilla1.Cells[14,gf] <> 'Baja') then begin
     try
      Com1.CommandText :='SPA_PagoBoletaDeuda '
      + valor
      + ' , ' + chr(39) + trim(expte.text) + chr(39)   //expte
      + ' , ' + eldni // dni
      + ' , ' + chr(39) + observ + chr(39)  // razon
      + ' , '  + modulo2.Usuario.UsuNro;  // usu
      Com1.Execute;
     except
      on E: Exception do begin
       EnviarLog(Self.Caption, E.Message);
       EnviarLog(Self.Caption, Com1.CommandText);
      end;
     end;
    end;
   end;
   messagedlg('Estados Guardados Correctamente!!',mtConfirmation,[mbok],0);
   for p:=0 to grilla1.ColCount-1 do
     for u:=1 to grilla1.RowCount-1 do grilla1.Cells[p,u]:='';
   grilla1.RowCount:=2;
   panel11.Visible:=false;
   label6.Visible:=false;
   label2.Visible:=false;
   l3.Visible:=false;
   expte.Visible:=false;
   edit3.Clear;
   l1.SetFocus;
   CONTRIBUYENTE.Close;
   FreeAndNil(Com1);
  end;
 end;
end;

