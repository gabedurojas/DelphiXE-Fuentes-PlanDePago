procedure TCons_Contrib.VerArea(nro:byte);
var Cnx2:TADOConnection;
begin
 Cnx2:=TADOConnection.Create(nil);
 Cnx2.LoginPrompt:=false;
 Cnx2.ConnectionString:=modulo2.Sistema.ConectUsu;
 DataSet.Connection:=Cnx2;
 if nro=1 then begin
  DataSet.CommandText:='SELECT nivel FROM usumodulos WHERE (modulo = 151) AND (codusu = ' + modulo2.Usuario.UsuNro + ');';
  DataSet.Open;
  dato:=DataSet.Fields[0].AsString;
  if dato = '1' then BEGIN
    PopupMenu1.Items[0].Enabled:=true;           PopupMenu1.Items[2].Enabled:=true;
    PopupMenu2.Items[0].Enabled:=true;           PopupMenu2.Items[1].Enabled:=true;
    PopupMenu2.Items[3].Enabled:=true;           PopupMenu2.Items[4].Enabled:=true;
