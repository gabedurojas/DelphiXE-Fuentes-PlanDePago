    PopupMenu1.Items[0].Enabled:=false;          PopupMenu1.Items[2].Enabled:=false;
    PopupMenu2.Items[0].Enabled:=false;          PopupMenu2.Items[1].Enabled:=false;
    PopupMenu2.Items[3].Enabled:=false;          PopupMenu2.Items[4].Enabled:=false;
  end;
  DataSet.Close;
 end;
 Cnx2.Close;
 FreeAndNil(Cnx2);
end;

procedure TCons_Contrib.grillactabancosClick(Sender: TObject);
begin
 if trim(grillactabancos.Cells[0,grillactabancos.Row]) <> '' then begin
  laidcuenta:=trim(grillactabancos.Cells[1,grillactabancos.Row]);
  elbank:=trim(grillactabancos.Cells[3,grillactabancos.Row]);
  tipocta:=trim(grillactabancos.Cells[4,grillactabancos.Row]);
  lasucur:=trim(grillactabancos.Cells[5,grillactabancos.Row]);
  lacuenta:=trim(grillactabancos.Cells[6,grillactabancos.Row]);
  lacbu:=trim(grillactabancos.Cells[7,grillactabancos.Row]);
  edit3.Text:=lacbu;
  edit1.Text:=lacuenta;
  edit2.Text:=elbank;
  if dato = '1' then begin
   if trim(grillactabancos.Cells[9,grillactabancos.Row])='True' then begin   // baja
    messagedlg('ATENCION esta Cuenta Bancaria se encuentra de BAJA, imposible su Confirmacion y/o Modificación..',mtInformation,[mbok],0);
    PopupMenu1.Items[0].Enabled:=false;
    PopupMenu1.Items[2].Enabled:=false;
    JvgGroupBox2.Enabled:=false;
   end
   else begin
    if trim(grillactabancos.Cells[8,grillactabancos.Row])='True' then PopupMenu1.Items[0].Enabled:=false
      else   PopupMenu1.Items[0].Enabled:=true;
    PopupMenu1.Items[2].Enabled:=true;
    JvgGroupBox2.Enabled:=true;
   end;
  end;
  Coloca1(3);
 end;
end;

