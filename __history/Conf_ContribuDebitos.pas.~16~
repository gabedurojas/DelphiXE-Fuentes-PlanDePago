procedure TCons_Contrib.grilladebitosClick(Sender: TObject);
begin
 if trim(grilladebitos.Cells[0,grilladebitos.Row]) <> '' then begin
  grilladebitos.Cells[13,grilladebitos.Row]:='X';
  if dato = '1' then begin
   if trim(grilladebitos.Cells[8,grilladebitos.Row])='True' then begin   // baja
    messagedlg('ATENCION este Debito se encuentra de BAJA, imposible su Confirmacion y/o Modificación..',mtInformation,[mbok],0);
    PopupMenu2.Items[3].Enabled:=false;
    PopupMenu2.Items[4].Enabled:=false;
   end
   else begin
    if trim(grilladebitos.Cells[7,grilladebitos.Row])='True' then begin    // confirmado
     PopupMenu2.Items[0].Enabled:=false;
     PopupMenu2.Items[1].Enabled:=false;
    end
    else begin
     PopupMenu2.Items[0].Enabled:=true;
     PopupMenu2.Items[1].Enabled:=true;
    end;
    PopupMenu2.Items[3].Enabled:=true;
    PopupMenu2.Items[4].Enabled:=true;
   end;
  end;
 end;
end;

