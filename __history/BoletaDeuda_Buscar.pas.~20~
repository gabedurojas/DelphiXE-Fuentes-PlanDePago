procedure TBoletaDeuda_Busca.ImprimirResultado1Click(Sender: TObject);
var ReporteRst: TfrxReport;
    frxDB1,frxDB2: TfrxDBDataset;
    t,y:integer;
    DtsCuotas:TClientDataSet;
begin
 t:=messagedlg('Confirma la Impresión de las Boletas de Deuda?',mtWarning,[mbok,mbCancel],0);
 if t = 1 then begin
  try
   DtsCuotas:=TClientDataSet.Create(nil);
   DtsCuotas.FieldDefs.Clear;
   DtsCuotas.Active:=False;
   with DtsCuotas.FieldDefs.AddFieldDef do begin
     Name:='Contribuyente';DataType:=ftString;Size:=50;
   end;
   with DtsCuotas.FieldDefs.AddFieldDef do begin
     Name:='NroDni';DataType:=ftString;Size:=20;
   end;
   with DtsCuotas.FieldDefs.AddFieldDef do begin
     Name:='TotalDeuda';DataType:=ftString;Size:=50;
   end;
   DtsCuotas.CreateDataSet;
   DtsCuotas.Active:=True;
   for t:=1 to Grilla1.RowCount-1 do begin
    if trim(grilla1.Cells[0,t]) = 'X' then begin
     DtsCuotas.Append;
     DtsCuotas.FieldValues['Contribuyente']:=grilla1.Cells[2,t];
     DtsCuotas.FieldValues['TotalDeuda']:=grilla1.Cells[3,t];
     DtsCuotas.FieldValues['NroDni']:=grilla1.Cells[4,t];
     DtsCuotas.Post;
    end;
   end;

   ReporteRst:=TfrxReport.Create(nil);
   frxDB1:=TfrxDBDataset.Create(nil);
   frxDB1.DataSet:=DtsCuotas;
   frxDB1.UserName:='frxDBDataset1';
   ReporteRst.LoadFromFile(Modulo2.Sistema.Path_todo + '\Reportes\Imp_IntimacionResultados.fr3');
   TfrxPictureView(ReporteRst.FindObject('Logo1')).Picture.LoadFromFile(Modulo2.Sistema.Path_todo + '\Imagenes\LogoM2.jpg');
   ReporteRst.Variables['ElqueSuscribe'] := QuotedStr(trim(EDIT1.TEXT));
   if cb1.Checked then ReporteRst.Variables['Barrio'] := QuotedStr(trim(L4.TEXT))
    else ReporteRst.Variables['Barrio'] := QuotedStr('');
   if cb2.Checked then begin
    ReporteRst.Variables['NroDni'] := QuotedStr(trim(EDIT3.TEXT));
    ReporteRst.Variables['Altura'] := QuotedStr(trim(EDIT4.TEXT));
   end
   else begin
    ReporteRst.Variables['NroDni'] := QuotedStr('');
    ReporteRst.Variables['Altura'] := QuotedStr('');
   end;
   ReporteRst.Variables['Total'] := QuotedStr(floattostr(sumad));
   ReporteRst.Variables['NroUsuario'] := QuotedStr(Modulo2.Usuario.UsuNro);
   ReporteRst.ShowReport;
  except
    on E: Exception do EnviarLog(Self.Caption, 'Error en Reporte ' + E.Message);
  end;
  FreeAndNil(frxDB1);
  FreeAndNil(ReporteRst);
 end;
end;

