procedure TBoletaDeuda_Busca.grilla1Click(Sender: TObject);
var b,t,j:integer;
begin
 if grilla1.Cells[1,grilla1.Row] <> '' then begin
  if trim(grilla1.Cells[3,grilla1.Row]) = '' then begin
    messagedlg('Contribuyente sin Deuda a la Fecha',mtError,[mbok,mbCancel],0);
  end
  else begin
   if trim(grilla1.Cells[0,grilla1.Row])='' then begin
    grilla1.Cells[0,grilla1.Row]:='X';
    totalselec1:=totalselec1 + 1;
   end
   else begin
    grilla1.Cells[0,grilla1.Row]:='';
    totalselec1:=totalselec1 - 1;
   end;
   eldato:=grilla1.Cells[1,grilla1.Row];
   Coloca1(3,eldato);
   verificagrilladeuda('grilla1');
   Barra1.Panels[2].Text:='Cant. Registros Seleccionados: ' + inttostr(totalselec1);
  end;
 end;
 if totalselec1=0 then PopupMenu1.Items[5].Enabled:=false
  else PopupMenu1.Items[5].Enabled:=true;

 sumad:=0;
 for t:=1 to grilla1.RowCount-1 do begin
  if (grilla1.Cells[0,t] = 'X')  then begin
    sumad := sumad + strtofloat(grilla1.Cells[3,t]);
  end;
 end;
 Barra1.Panels[3].Text:='Total Deuda Seleccionada: $' + floattostr(sumad);
end;

