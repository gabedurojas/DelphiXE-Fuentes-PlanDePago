procedure TBoletaDeuda_Busca.ExportaraExcel1Click(Sender: TObject);
var txt1:widestring;
    t,y:integer;
begin
  RE.Clear;
  RE.Lines.Add('');
  RE.Lines.Add('Criteros de Filtros');
  RE.Lines.Add('');
  if trim(edit1.Text) <> '' then RE.Lines.Add('Contribuyente: ' + trim(edit1.Text));
  if cb2.Checked then begin
    RE.Lines.Add('Deuda Mayor a: ' + trim(edit3.Text));
    RE.Lines.Add('Deuda Menor a: ' + trim(edit4.Text));
  end;
  if cb1.Checked then begin
    RE.Lines.Add('Barrio: ' + trim(l4.text));
  end;
  RE.Lines.Add('');
  txt1:='';
  for y:=0 to Grilla1.ColCount-1 do
    txt1:=txt1 + Grilla1.Cells[y,0] + chr(9);
  RE.Lines.Append(txt1);
  for t:=1 to Grilla1.RowCount-1 do begin
    txt1:='';
    for y:=0 to Grilla1.ColCount-1 do
      txt1:=txt1 + Grilla1.Cells[y,t] + chr(9);
    RE.Lines.Append(txt1);
  end;
  RE.SelectAll;
  RE.CopyToClipboard;
  messagedlg('Datos Copiados Correctamante!!' + chr(13)
  + 'Abra Excel y pegue los datos en la hoja activa...',mtWarning,[mbok],0)
end;

