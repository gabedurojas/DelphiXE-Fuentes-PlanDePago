procedure TBoletaDeuda_Busca.guardaClick(Sender: TObject);
var t,y,a:integer;
    Com1:TADOCommand;
    comando,comando1:widestring;
    tx,idcont,tx1,txt2:string;
    Cnx2:TADOConnection;
begin
 t:=messagedlg('Confirma guardar las Boletas de Deudas seleccionada?',mtInformation,[mbok,mbCancel],0);
 if t = 1 then begin
  if totalselec = 0 then begin
    messagedlg('            I M P O S I B L E   G U A R D A R' + chr(13)
    + 'Este Lote de Boleta de Deuda, porque no existe ningun Objeto Seleccionado ',mtError,[mbok],0);
    if JvgGroupBox1.Visible then edit1.SetFocus;
  end
  else begin
   if (trim(Edit2.Text) = '') OR (trim(Edit2.Text) = '0')
    OR (trim(Edit2.Text) = '00') OR (trim(Edit2.Text) = '000') OR (trim(Edit2.Text) = '00000') then begin
    messagedlg('Error!! No Existe Nro de Disposicion Ingresado...',mterror,[mbok],0);
    Edit2.SetFocus;
   end
   else begin
    SplashConNro := TSplashConNro.Create(Application);
    SplashConNro.Show;
    SplashConNro.ProgressBar1.Max:=grilla1.RowCount- 1;
    Cnx2:=TADOConnection.Create(nil);
    Cnx2.LoginPrompt:=false;
    Cnx2.ConnectionString:=Modulo2.Sistema.ConectInti;
    Com1:=TADOCommand.Create(nil);
    Com1.Connection:=Cnx2;
    try
     DataSet2.Connection:=Cnx2;
     DataSet2.CommandText:='SPA_IntimacionLote ' + modulo2.Usuario.UsuNro
     + ' , ' + chr(39) + trim(l3.Text) + chr(39)
     + ' , ' + chr(39) + StrFill(trim(edit2.Text),5,'0','') + trim(label4.Caption) + chr(39)
     + ' , 1 ';
     DataSet2.Open;
     tx1:=DataSet2.Fields[0].AsString;
     txt2:=DataSet2.Fields[1].AsString;
     DataSet2.Close;
     DataSet2.Connection:=nil;
     for t:=1 to grilla1.RowCount-1 do begin
      if (grilla1.Cells[0,t] = 'X') then begin
       DataSet1.Connection:=Cnx2;
       DataSet1.CommandText:='SPA_BoletoDeudaContribuyente ' + grilla1.Cells[1,t]
