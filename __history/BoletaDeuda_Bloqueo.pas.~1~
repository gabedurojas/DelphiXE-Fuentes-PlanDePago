function TBolDeuda_Bloqueo.VerificaGrillaDeuda(grilla:string):boolean;
var j,a:integer;
begin
 selecfila:=0;
 Result:=true;
 for j:=1 to grilla1.RowCount-1 do begin
  if trim(grilla1.Cells[1,j])='X' then begin
    selecfila:=selecfila+1;
    Result:=false;
    break;
  end;
 end;
 if selecfila=0 then  confirma.Enabled :=false
  else confirma.Enabled :=true;
 end;

function TBolDeuda_Bloqueo.VerificaGrilla(grilla:string):boolean;
var j,a:integer;
begin
 selecfila:=0;
 Result:=true;
 for j:=1 to grilla2.RowCount-1 do begin
  if trim(grilla2.Cells[1,j])='X' then begin
    selecfila:=selecfila+1;
    Result:=false;
    break;
  end;
 end;
 if selecfila=0 then  confirma.Enabled :=false
  else confirma.Enabled :=true;
end;

