procedure TBolDeuda_Bloqueo.confirmaClick(Sender: TObject);
var t,y,gf,p,u:integer;
    Com2:TADOCommand;
    texto:string;
begin
 if pc1.ActivePageIndex=1 then begin
  panel1.Visible:=true;
  l4.SetFocus;
 end;
 if pc1.ActivePageIndex=2 then begin
  t:=messagedlg('Confirma el Cambio de Estados para las Boletas de Deudas seleccionadas?',mtWarning,[mbok,mbCancel],0);
  if t = 1 then begin
   if selecfila = 0 then begin
    messagedlg('            I M P O S I B L E   C O N F I R M A R ' + chr(13)
    + 'porque no existe ninguna Intimación Seleccionada ',mtError,[mbok],0);
    panel1.Visible:=false;
    grilla2.SetFocus;
   end
   else begin
    Com2:=TADOCommand.Create(nil);
    Com2.ConnectionString:=Modulo2.Sistema.ConectUsu;
     texto:='Desbloqueo por Boleto de Deuda p/Sistema';
     for gf:=1 to grilla2.RowCount-1 do begin
      if (grilla2.Cells[1,gf] = 'X') then begin
       try
        Com2.CommandText :='SPB_BloqueosDesdeBoletaDeuda ' + trim(grilla2.Cells[15,gf])
        + ' , ' + trim(grilla2.Cells[2,gf])
        + ' , ' + chr(39) + texto + chr(39)
        + ' , ' + modulo2.Usuario.UsuNro;
        Com2.Execute;
       except
        on E: Exception do begin
          EnviarLog(Self.Caption, E.Message);
          EnviarLog(Self.Caption, Com2.CommandText);
        end;
       end;
      end;
     end;
      messagedlg('Estados Guardados Correctamente!!',mtConfirmation,[mbok],0);
      LOSOBJETOS.Close;
      FreeAndNil(Com2);
   end;
  end;
  filtrar.Click;
 end;
end;

