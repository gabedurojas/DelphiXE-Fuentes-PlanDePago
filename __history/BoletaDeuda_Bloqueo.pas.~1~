procedure TBolDeuda_Bloqueo.AceptarClick(Sender: TObject);
var t,y,gf,p,u:integer;
    Com1,Com2:TADOCommand;
begin
t:=messagedlg('Confirma el Cambio de Estados para las Boletas de Deudas seleccionadas?',mtWarning,[mbok,mbCancel],0);
if t = 1 then begin
 if selecfila = 0 then begin
   messagedlg('            I M P O S I B L E   C O N F I R M A R ' + chr(13)
   + 'porque no existe ninguna Boleta de Deuda Seleccionada ',mtError,[mbok],0);
   panel1.Visible:=false;
   grilla1.SetFocus;
 end
 else begin
  Com1:=TADOCommand.Create(nil);
  Com1.ConnectionString:=Modulo2.Sistema.ConectInti;

  Com2:=TADOCommand.Create(nil);
  Com2.ConnectionString:=Modulo2.Sistema.ConectUsu;

  for gf:=1 to grilla1.RowCount-1 do begin
   if (grilla1.Cells[1,gf] = 'X') then begin
    try
     Com1.CommandText :='UPDATE IntimacionContribuyenteEstado SET Activo=0 '
     + ' where (IdIntimacionContribuyente='+ trim(grilla1.Cells[16,gf]) + ')';
     Com1.Execute;
     Com1.CommandText :='SPA_IntimacionContribuyenteEstado ' + trim(grilla1.Cells[16,gf])
     + ' , ' + TComboClase(L4.Items.Objects[L4.ItemIndex]).Param1
     + ' , 1 , '  + modulo2.Usuario.UsuNro
     + ' , ' + chr(39) + observ + chr(39);
     Com1.Execute;

     Com2.CommandText :='SPA_BloqueosDesdeBoletaDeuda ' + trim(grilla1.Cells[15,gf])
     + ' , ' + trim(grilla1.Cells[2,gf])
     + ' , ' + modulo2.Usuario.UsuNro;
     Com2.Execute;
    except
    on E: Exception do begin
     EnviarLog(Self.Caption, E.Message);
     EnviarLog(Self.Caption, Com1.CommandText);
     EnviarLog(Self.Caption, E.Message);
     EnviarLog(Self.Caption, Com2.CommandText);
    end;
    end;
   end;
  end;
  messagedlg('Estados Guardados Correctamente!!',mtConfirmation,[mbok],0);
  panel1.Visible:=false;
  label6.Visible:=false;
  label2.Visible:=false;
  l3.Visible:=false;
  expte.Visible:=false;
  CONTRIBUYENTE.Close;
  FreeAndNil(Com1);
  FreeAndNil(Com2);
 end;
 filtrar.Click;
end;
end;

