procedure TBolDeuda_Bloqueo.Coloca1(nro:byte;valor:string);
var t,b,y,p,u:integer;
    tx:string;
begin
sumad:=0;
try
 Modulo2.ObjConexion:=TADOConnection.Create(nil);
 Modulo2.ObjConexion.LoginPrompt:=false;
 Modulo2.ObjConexion.ConnectionString:=modulo2.Sistema.ConectInti;
 if nro = 0 then begin
  DataSet3.Close;
  DataSet3.Connection:=modulo2.ObjConexion;
  DataSet3.CommandText:='select NroLote,FechaLote,NombreUsuario,Usuario,NroDisposicion,IdIntimacionlote,Confirmado '
  + ' from Fn_LotesBoletoDeudaContribuyentes ('+  valor +')';
  DataSet3.Open;
  DataSet3.Connection:=nil;
 end;
 if nro = 1 then begin
  LOSOBJETOS.Close;
  LOSOBJETOS.Connection:=modulo2.ObjConexion;
  LOSOBJETOS.CommandText:='SELECT dbo.IntimacionContribuyente.NroControl,dbo.IntimacionContribuyente.IdContribuyente,'
  + 'dbo.IntimacionContribuyente.Contribuyente, dbo.IntimacionContribuyente.NroDni, dbo.IntimacionContribuyente.Barrio,'
  + 'dbo.IntimacionContribuyente.Calle, dbo.IntimacionContribuyente.Altura, dbo.IntimacionContribuyente.Dpto,'
  + 'dbo.IntimacionContribuyente.Mza, dbo.IntimacionContribuyente.Casa,dbo.IntimacionContribuyente.Torre,'
  + 'dbo.IntimacionContribuyente.Domicilio, dbo.IntimacionContribuyente.ImporteDeuda, dbo.IntimacionContribuyente.Impreso,'
  + 'dbo.IntimacionContribuyenteEstado.Activo, dbo.IntimacionContribuyenteEstado.IdTipoEstado,dbo.IntimacionLote.NroLote,'
  + 'dbo.TiposEstados.DetalleEstado,dbo.IntimacionContribuyente.Id FROM dbo.IntimacionContribuyente '
  + ' INNER JOIN dbo.IntimacionContribuyenteEstado ON dbo.IntimacionContribuyente.Id = dbo.IntimacionContribuyenteEstado.IdIntimacionContribuyente'
  + ' inner join dbo.TiposEstados on dbo.TiposEstados.NroEstado = dbo.IntimacionContribuyenteEstado.IdTipoEstado'
  + ' INNER JOIN DBO.IntimacionLote on DBO.IntimacionLote.Id = IntimacionContribuyente.IdIntimacionLote '
  + ' WHERE (dbo.IntimacionContribuyenteEstado.Activo = 1) AND (DBO.IntimacionLote.EsBoletaDeuda = 1)'
  + ' AND (DBO.IntimacionLote.Baja=0) and ' +  valor + ' AND (IdTipoEstado = 11) order by 1' ;
  LOSOBJETOS.Open;
  if LOSOBJETOS.IsEmpty then begin
    for p:=0 to grilla2.ColCount-1 do
     for u:=1 to grilla2.RowCount-1 do grilla2.Cells[p,u]:='';
      grilla2.RowCount:=2;
  end
  else begin
   for t:=1 to LOSOBJETOS.RecordCount do begin
    LOSOBJETOS.RecNo:=t;
    grilla2.RowCount:=t + 1;
    grilla2.Cells[0,t]:=StrFill(IntToStr(t),2,'0','');
    grilla2.Cells[1,t]:='';
    grilla2.Cells[2,t]:=LOSOBJETOS.FieldByName('NroControl').AsString;
    grilla2.Cells[3,t]:=LOSOBJETOS.FieldByName('Contribuyente').AsString;
    grilla2.Cells[4,t]:=LOSOBJETOS.FieldByName('NroDni').AsString;
    grilla2.Cells[5,t]:=LOSOBJETOS.FieldByName('Barrio').AsString;
    grilla2.Cells[6,t]:=LOSOBJETOS.FieldByName('Calle').AsString;
    grilla2.Cells[7,t]:=LOSOBJETOS.FieldByName('Altura').AsString;
    grilla2.Cells[8,t]:=LOSOBJETOS.FieldByName('Dpto').AsString;
    grilla2.Cells[9,t]:=LOSOBJETOS.FieldByName('Mza').AsString;
    grilla2.Cells[10,t]:=LOSOBJETOS.FieldByName('Casa').AsString;
    grilla2.Cells[11,t]:=LOSOBJETOS.FieldByName('Torre').AsString;
    grilla2.Cells[12,t]:=LOSOBJETOS.FieldByName('Domicilio').AsString;
    grilla2.Cells[13,t]:=LOSOBJETOS.FieldByName('ImporteDeuda').AsString;
    grilla2.Cells[14,t]:=LOSOBJETOS.FieldByName('DetalleEstado').AsString;
    grilla2.Cells[15,t]:=LOSOBJETOS.FieldByName('NroLote').AsString;
    grilla2.Cells[16,t]:=LOSOBJETOS.FieldByName('Id').AsString;
   end;
  end;
  LOSOBJETOS.Connection:=nil;
 end;
 if nro = 2 then begin
  CONTRIBUYENTE.Close;
  CONTRIBUYENTE.Connection:=modulo2.ObjConexion;
  CONTRIBUYENTE.CommandText:='SELECT dbo.IntimacionContribuyente.NroControl,dbo.IntimacionContribuyente.IdContribuyente,'
  + 'dbo.IntimacionContribuyente.Contribuyente, dbo.IntimacionContribuyente.NroDni, dbo.IntimacionContribuyente.Barrio,'
  + 'dbo.IntimacionContribuyente.Calle, dbo.IntimacionContribuyente.Altura, dbo.IntimacionContribuyente.Dpto,'
  + 'dbo.IntimacionContribuyente.Mza, dbo.IntimacionContribuyente.Casa,dbo.IntimacionContribuyente.Torre,'
  + 'dbo.IntimacionContribuyente.Domicilio, dbo.IntimacionContribuyente.ImporteDeuda, dbo.IntimacionContribuyente.Impreso,'
  + 'dbo.IntimacionContribuyenteEstado.Activo, dbo.IntimacionContribuyenteEstado.IdTipoEstado,dbo.IntimacionLote.NroLote,'
  + 'dbo.TiposEstados.DetalleEstado,dbo.IntimacionContribuyente.Id FROM dbo.IntimacionContribuyente '
  + ' INNER JOIN dbo.IntimacionContribuyenteEstado ON dbo.IntimacionContribuyente.Id = dbo.IntimacionContribuyenteEstado.IdIntimacionContribuyente'
  + ' inner join dbo.TiposEstados on dbo.TiposEstados.NroEstado = dbo.IntimacionContribuyenteEstado.IdTipoEstado'
  + ' INNER JOIN DBO.IntimacionLote on DBO.IntimacionLote.Id = IntimacionContribuyente.IdIntimacionLote '
  + ' WHERE (dbo.IntimacionContribuyenteEstado.Activo = 1) AND (DBO.IntimacionLote.EsBoletaDeuda = 1)'
  + ' AND (DBO.IntimacionLote.Baja=0) and ' +  valor + ' AND IdTipoEstado NOT IN (11,12) order by 1' ;
  CONTRIBUYENTE.Open;
  if CONTRIBUYENTE.IsEmpty then begin
   for p:=0 to grilla1.ColCount-1 do
    for u:=1 to grilla1.RowCount-1 do grilla1.Cells[p,u]:='';
     grilla1.RowCount:=2;
   end
   else begin
    for t:=1 to CONTRIBUYENTE.RecordCount do begin
     CONTRIBUYENTE.RecNo:=t;
     grilla1.RowCount:=t + 1;
     grilla1.Cells[0,t]:=StrFill(IntToStr(t),2,'0','');
     grilla1.Cells[1,t]:='';
     grilla1.Cells[2,t]:=CONTRIBUYENTE.FieldByName('NroControl').AsString;
     grilla1.Cells[3,t]:=CONTRIBUYENTE.FieldByName('Contribuyente').AsString;
     grilla1.Cells[4,t]:=CONTRIBUYENTE.FieldByName('NroDni').AsString;
     grilla1.Cells[5,t]:=CONTRIBUYENTE.FieldByName('Barrio').AsString;
     grilla1.Cells[6,t]:=CONTRIBUYENTE.FieldByName('Calle').AsString;
     grilla1.Cells[7,t]:=CONTRIBUYENTE.FieldByName('Altura').AsString;
     grilla1.Cells[8,t]:=CONTRIBUYENTE.FieldByName('Dpto').AsString;
     grilla1.Cells[9,t]:=CONTRIBUYENTE.FieldByName('Mza').AsString;
     grilla1.Cells[10,t]:=CONTRIBUYENTE.FieldByName('Casa').AsString;
     grilla1.Cells[11,t]:=CONTRIBUYENTE.FieldByName('Torre').AsString;
     grilla1.Cells[12,t]:=CONTRIBUYENTE.FieldByName('Domicilio').AsString;
     grilla1.Cells[13,t]:=CONTRIBUYENTE.FieldByName('ImporteDeuda').AsString;
     grilla1.Cells[14,t]:=CONTRIBUYENTE.FieldByName('DetalleEstado').AsString;
     grilla1.Cells[15,t]:=CONTRIBUYENTE.FieldByName('NroLote').AsString;
     grilla1.Cells[16,t]:=CONTRIBUYENTE.FieldByName('Id').AsString;
    end;
    Barra1.Panels[1].Text:='Cant. Registros: ' + inttostr(CONTRIBUYENTE.RecordCount);
   end;
  CONTRIBUYENTE.Connection:=nil;
  end;
  FreeAndNil(Modulo2.ObjConexion);
except
  on E: Exception do begin
    EnviarLog(Self.Caption, E.Message);
  end
end;
end;

