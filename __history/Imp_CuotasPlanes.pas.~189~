Function TImpresionPlanes.los_periodos():widestring;
var j,an:integer;
    pran:string;
    kf:boolean;
begin
{Damos los Periodos involucrados}
 cont:='';
 kf:=false;
 an:=0;
 for j:=1 to PLANES.RecordCount do begin
  PLANES.RecNo:=j;
  pran:=strcut(trim(PLANES.Fields[1].AsString),4);
  if an <> strtoint(pran) then begin
   if trim(cont) <> '' then cont:=cont + '/' + inttostr(an) + ' - '
   else begin
     if an=0 then an:=strtoint(pran)
     else cont:=cont + '/' + inttostr(an) + ' - ';
   end;
   an:=strtoint(pran);
   kf:=false;
  end;
  if not(kf) then begin
   cont:=cont + strcut_midle(trim(PLANES.Fields[1].Text),5,6);
   kf:=true;
  end
  else cont:=cont + ',' + strcut_midle(trim(PLANES.Fields[1].Text),5,6);
 end;
 cont:=cont + '/' + inttostr(an) + ' - ';
end;

