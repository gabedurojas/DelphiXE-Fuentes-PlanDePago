procedure TImpresionPlanes.VerArea(nro:byte);
var t,b:integer;
    Cnx2:TADOConnection;
begin
 Cnx2:=TADOConnection.Create(nil);
 Cnx2.LoginPrompt:=false;
 Cnx2.ConnectionString:=Modulo2.Sistema.ConectDb;
 if nro=1 then begin
  DataSet2.Close;
  DataSet2.Connection:=Cnx2;
  DataSet2.CommandText:='SELECT NroUsuario as Nrousuario FROM Fn_PlanPagoUsuariosAdmin  (' + modulo2.Usuario.UsuNro + ')';
  DataSet2.Open;
  if not Dataset2.IsEmpty  then dato:=DataSet2.Fields[0].AsString
   else dato:='0';
  DataSet2.Connection:=nil;
 end;
 Cnx2.Close;
 block.Visible:=false;
 FreeAndNil(Cnx2);
end;

procedure TImpresionPlanes.FormActivate(Sender: TObject);
begin
 if not(gh) then begin
   gh:=true;
   titrespo:=false;
   PANEL.Visible:=FALSE;
   IMPCTAESP.Visible :=FALSE;
   PageControl2.ActivePage:=PageControl2.Pages[0];
   FechaAct:=LeftStr(Fec_System(),10);
   if Modulo2.ObtenerNivelAcceso('152') <> 1 then C1.Enabled:=false
   else C1.Enabled:=true;
   nrodeplan.SetFocus;
   CambiaCuota.Visible:=false;
   VerArea(1);
   if dato <> '0' then begin
    GrupoAdmin.Visible :=true;
    PopupMenu1.Items[6].Enabled:=true;
    PopupMenu1.Items[7].Enabled:=true;
   end
   else begin
    GrupoAdmin.Visible:=false;
    PopupMenu1.Items[6].Enabled:=false;
    PopupMenu1.Items[7].Enabled:=false;
   end;
   Coloca1(6);
 end;
end;

