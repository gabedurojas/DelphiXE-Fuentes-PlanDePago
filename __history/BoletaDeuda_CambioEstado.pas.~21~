procedure TBoletaDeuda_CambEstado.VerificarUsuario(nro:byte);
var t,b:integer;
    Cnx2:TADOConnection;
begin
 Cnx2:=TADOConnection.Create(nil);
 Cnx2.LoginPrompt:=false;
 if nro=1 then begin
  Cnx2.ConnectionString:=modulo2.Sistema.ConectInti;
  DataSet2.Close;
  DataSet2.Connection:=Cnx2;
  DataSet2.CommandText:='SELECT NroUsuario FROM Fn_BoletaDeudaaLegalAdmin  (' + modulo2.Usuario.UsuNro + ')';
  DataSet2.Open;
  if not Dataset2.IsEmpty  then usunro:=DataSet2.Fields[0].AsString
    else usunro:='0';
  DataSet2.Connection:=nil;
 end;
 Cnx2.Close;
 FreeAndNil(DataSet2);
