procedure TBoletaDeuda_CambEstado.filtrarClick(Sender: TObject);
begin
  if l1.ItemIndex = 0 THEN BEGIN
    Dato:='(dbo.IntimacionLote.NroLote = ' + trim(edit3.Text) + ') order by 1' ;
    Coloca1(2,dato);
  end;
  if l1.ItemIndex = 1 then begin
    Dato:= '(dbo.IntimacionContribuyente.NroControl = ' + trim(edit3.Text) + ') order by 1' ;
    Coloca1(2,dato);
  end;
  if l1.ItemIndex = 2 THEN BEGIN
    Dato:='(dbo.IntimacionContribuyente.Contribuyente LIKE ' + chr(39) + chr(37)
    + AnsiReplaceStr(trim(Edit3.Text),chr(39),chr(33)) + chr(37) + chr(39) +') order by 1' ;
    Coloca1(2,dato);
  end;
end;

procedure TBoletaDeuda_CambEstado.CargaCombos(nro:byte);
begin
 if usunro <> '0' then begin
  if nro=1 then Modulo2.CargaCombo(L4,'SELECT DetalleEstado,NroEstado FROM TiposEstados where nroestado > 1 '
  + ' and BoletaDeuda=1 and NroEstado NOT IN (13) order by 1',modulo2.Sistema.ConectInti,false);
 end
 else begin
  if nro=1 then Modulo2.CargaCombo(L4,'SELECT DetalleEstado,NroEstado FROM TiposEstados where nroestado > 1 '
  + ' and BoletaDeuda=1 and NroEstado NOT IN (12,13) order by 1',modulo2.Sistema.ConectInti,false);
  //+ ' and BoletaDeuda=1 and nroestado = 11 order by 1',modulo2.Sistema.ConectInti,false);
 end;
end;

function TBoletaDeuda_CambEstado.VerificaGrillaDeuda(grilla:string):boolean;
var j,a:integer;
begin
 selecfila:=0;
 Result:=true;
 for j:=1 to grilla1.RowCount-1 do begin
  if trim(grilla1.Cells[1,j])='X' then begin
   selecfila:=selecfila+1;
   Result:=false;
   break;
  end;
 end;
 if selecfila=0 then  confirma.Enabled :=false
  else confirma.Enabled :=true;
end;

procedure TBoletaDeuda_CambEstado.FormKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
